#   ["SELECT ALL a FROM t", ["select_all"], true],
#   ["SELECT a FROM t", ["select_all"], false],
#   ["SELECT DISTINCT a FROM t", ["select_all"], false],
#   ["SELECT * FROM a JOIN b ON 1", ["from", 0, "inner"], false],
#   ["SELECT * FROM a INNER JOIN b ON 1", ["from", 0, "inner"], true],
#   ["SELECT * FROM a JOIN b ON 1", ["from", 0, "outer"], false],
#   ["SELECT * FROM a LEFT JOIN b ON 1", ["from", 0, "outer"], false],
#   ["SELECT * FROM a LEFT OUTER JOIN b ON 1", ["from", 0, "outer"], true],
#   ["SELECT * FROM a LEFT OUTER JOIN b ON 1", ["from", 0, "kind"], "LEFT"],
#   ["SELECT * FROM a FULL OUTER JOIN b ON 1", ["from", 0, "outer"], true],
#   ["SELECT * FROM a CROSS JOIN b", ["from", 0, "inner"], false],
#   ["SELECT * FROM a NATURAL JOIN b", ["from", 0, "inner"], false]
# ])
def test_details_shape(sql, path, expected):
  assert_eq(_path(first(sql::sql_ast(sql)), path), expected)
end
