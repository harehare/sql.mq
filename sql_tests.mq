#   ["DELETE FROM t WHERE a ORDER BY b DESC", ["order_by", 0, "direction"], "DESC"],
#   ["DELETE FROM t", ["order_by"], []],
#   ["CREATE INDEX i ON t (a) INCLUDE (b, c)", ["include"], ["b", "c"]],
#   ["CREATE INDEX i ON t (a)", ["include"], []],
#   ["CREATE INDEX i ON t (a COLLATE \"C\")", ["columns", 0, "expr", "type"], "collate"],
#   ["CREATE INDEX i ON t (a) INCLUDE (b) WHERE a > 0", ["where", "op"], ">"],
#   ["CREATE TABLE a (x INT, LIKE b)", ["constraints", 0, "kind"], "other"],
#   ["CREATE TABLE a (x INT, LIKE b INCLUDING ALL)", ["constraints", 0, "sql"], "LIKE b INCLUDING ALL"],
#   ["CREATE TABLE a (x INT, EXCLUDE USING gist (c WITH &&))", ["constraints", 0, "sql"], "EXCLUDE USING gist(c WITH &&)"],
#   ["ALTER TABLE t ALTER COLUMN a TYPE int USING a::int", ["actions", 0, "sql"], "ALTER COLUMN a TYPE int USING a::int"]
# ])
def test_statement_shape_dialects(sql, path, expected):
  assert_eq(_path(first(sql::sql_ast(sql)), path), expected)
end

