#   ["SELECT 'a'"],
#   ["SELECT a FROM t WHERE a ->> 'k' = 'v'"],
#   ["SELECT a FROM t WHERE a @> '{\"k\":1}'::jsonb"],
#   ["SELECT a FROM unnest(ARRAY[1, 2]) AS u (x)"],
#   ["SELECT * FROM t, LATERAL f(t.a)"],
#   ["SELECT a FROM t NATURAL LEFT JOIN u"],
#   ["SELECT a FROM t WHERE EXISTS (SELECT 1) AND NOT EXISTS (SELECT 2)"],
#   ["VALUES (1) UNION VALUES (2)"],
#   ["(SELECT 1)"],
#   ["(SELECT 1)"],
#   ["SELECT 1 FROM (SELECT 1) AS x JOIN (SELECT 2) AS y ON TRUE"],
#   ["SELECT a COLLATE pg_catalog.\"default\" FROM t"],
#   ["SELECT a[1][2], (ARRAY[1, 2])[1]"],
#   ["SELECT ARRAY(SELECT 1)"],
#   ["SELECT 'x' AS \"y\", 'a'"],
#   ["SELECT x FROM t WHERE y = ANY (SELECT 1)"],
#   ["SELECT TOP (5) PERCENT WITH TIES a FROM t ORDER BY a"],
#   ["SELECT DISTINCT TOP 3 a FROM t"],
#   ["SELECT a FROM t WITH (NOLOCK, INDEX(i))"],
#   ["SELECT a FROM t AS x TABLESAMPLE BERNOULLI (5) REPEATABLE (1)"],
#   ["SELECT a FROM t GROUP BY a, b WITH ROLLUP"],
#   ["SELECT * FROM a CROSS APPLY f(a.x) AS g"],
#   ["UPDATE t SET (a, b) = (1, 2), c = 3 WHERE d"],
#   ["DELETE FROM t WHERE a ORDER BY b DESC LIMIT 2"],
#   ["INSERT INTO t SET a = 1, b = 2"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT ON CONSTRAINT pk DO UPDATE SET a = 2"],
#   ["WITH c AS (SELECT 1) INSERT INTO t (a) SELECT * FROM c RETURNING a"],
#   ["WITH a AS (SELECT 1), b AS (SELECT 2) UPDATE t SET x = 1 FROM a, b"],
#   ["CREATE TABLE a (\n  x INT,\n  EXCLUDE USING gist(c WITH &&),\n  CHECK (x > 0)\n)"],
#   ["CREATE UNIQUE INDEX i ON t USING BTREE (a) INCLUDE (b, c) WHERE a > 0"],
#   ["SELECT a FROM unnest(ARRAY[1, 2]) AS u (x), generate_series(1, 2) AS g (n)"]
# ])
def test_stringify_dialects_idempotent(sql):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), sql)
end

def _expr_of2(sql):
  first(first(sql::sql_ast("SELECT " + sql))["columns"])["expr"]
end

# New expression shapes: [expression, path, expected]
# @parametrize([
#   ["ARRAY[1, 2]", ["items", 1, "value"], "2"],
#   ["ARRAY[]", ["items"], []],
#   ["ARRAY[[1, 2], [3]]", ["items", 1, "items", 0, "value"], "3"],
#   ["ARRAY[1]", ["type"], "array"],
#   ["arr[1]", ["type"], "subscript"],
#   ["arr[1]", ["index", "value"], "1"],
#   ["a[1:2]", ["upper", "value"], "2"],
#   ["a[1]", ["upper"], None],
#   ["a[1][2]", ["expr", "type"], "subscript"],
#   ["(ARRAY[1])[1]", ["expr", "paren"], true],
#   ["x::int[]", ["data_type"], "int[]"],
#   ["ARRAY(SELECT 1)", ["name"], "ARRAY"],
#   ["ARRAY(SELECT 1)", ["args", 0, "type"], "select"],
#   ["x = ANY(ARRAY[1])", ["right", "quantifier"], "ANY"],
#   ["x = ALL (SELECT 1)", ["right", "query", "type"], "select"],
#   ["x = SOME(ARRAY[1])", ["right", "expr", "type"], "array"],
#   ["x > ANY (SELECT 1)", ["op"], ">"],
#   ["a COLLATE \"C\"", ["collation"], "C"],
#   ["a COLLATE pg_catalog.\"default\"", ["collation"], "pg_catalog.default"],
#   ["a COLLATE c || b", ["op"], "||"],
#   ["a COLLATE c", ["expr", "parts"], ["a"]],
#   ["a AT TIME ZONE 'UTC'", ["op"], "AT TIME ZONE"],
#   ["a AT TIME ZONE 'UTC' + 1", ["op"], "+"],
#   ["a AT TIME ZONE 'UTC' + 1", ["left", "op"], "AT TIME ZONE"],
#   ["@x := 1", ["op"], ":="],
#   ["E'a\\nb'", ["value"], "a\nb"],
#   ["E'it\\'s'", ["value"], "it's"],
#   ["E'it''s'", ["value"], "it's"],
#   ["E'a\\\\b'", ["value"], "a\\b"],
#   ["N'x'", ["prefix"], "N"],
#   ["X'FF'", ["prefix"], "X"],
#   ["B'1'", ["prefix"], "B"],
#   ["'x'", ["prefix"], None],
#   ["'a' 'b' 'c'", ["value"], "abc"],
#   ["$$a'b$$", ["value"], "a'b"],
#   ["$t$a$$b$t$", ["value"], "a$$b"],
#   ["$$$$", ["value"], ""],
#   ["0b101", ["value"], "0b101"],
#   ["0B1", ["value"], "0B1"],
#   ["0x1F", ["value"], "0x1F"],
#   ["agg(a ORDER BY b DESC)", ["order_by", 0, "direction"], "DESC"],
#   ["agg(a, b ORDER BY c, d)", ["order_by", 1, "expr", "parts"], ["d"]],
#   ["f(a)", ["order_by"], []],
#   ["percentile_cont(0.5) WITHIN GROUP (ORDER BY a)", ["within_group", 0, "expr", "parts"], ["a"]],
#   ["f(a)", ["within_group"], []],
#   ["percentile_cont(0.5) WITHIN GROUP (ORDER BY a) FILTER (WHERE b)", ["filter", "parts"], ["b"]]
# ])
def test_expression_shape_dialects(sql, path, expected):
  assert_eq(_path(_expr_of2(sql), path), expected)
end

