#   ["INSERT OR REPLACE INTO t (a) VALUES (1)", "INSERT OR REPLACE INTO t (a) VALUES (1)"],
#   ["INSERT IGNORE INTO t (a) VALUES (1)", "INSERT IGNORE INTO t (a) VALUES (1)"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT DO NOTHING", "INSERT INTO t (a) VALUES (1) ON CONFLICT DO NOTHING"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING", "INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO UPDATE SET a = excluded.a", "INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO UPDATE SET a = excluded.a"],
#   ["INSERT INTO t (a, b) VALUES (1, 2) ON CONFLICT (a) DO UPDATE SET b = 3 WHERE t.a > 0", "INSERT INTO t (a, b) VALUES (1, 2) ON CONFLICT (a) DO UPDATE SET b = 3 WHERE t.a > 0"],
#   ["INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = a + 1, b = 2", "INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = a + 1, b = 2"],
#   ["INSERT INTO t (a) VALUES (1) RETURNING a, b AS c", "INSERT INTO t (a) VALUES (1) RETURNING a, b AS c"],
#   ["INSERT INTO t (a) VALUES (1) RETURNING *", "INSERT INTO t (a) VALUES (1) RETURNING *"],
