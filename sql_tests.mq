#   ["CREATE UNIQUE INDEX i ON t (a, b DESC)", "CREATE UNIQUE INDEX i ON t (a, b DESC)"],
#   ["CREATE INDEX IF NOT EXISTS i ON t USING btree (lower(a))", "CREATE INDEX IF NOT EXISTS i ON t USING BTREE (lower(a))"],
#   ["CREATE INDEX ON t (a) WHERE a > 0", "CREATE INDEX ON t (a) WHERE a > 0"],
#   ["CREATE VIEW v AS SELECT 1", "CREATE VIEW v AS SELECT 1"],
#   ["CREATE OR REPLACE VIEW v (a, b) AS SELECT 1, 2", "CREATE OR REPLACE VIEW v (a, b) AS SELECT 1, 2"],
#   ["CREATE MATERIALIZED VIEW v AS SELECT 1", "CREATE MATERIALIZED VIEW v AS SELECT 1"],
#   ["CREATE TEMPORARY VIEW IF NOT EXISTS v AS SELECT 1", "CREATE TEMPORARY VIEW IF NOT EXISTS v AS SELECT 1"],
#   ["ALTER TABLE t ADD COLUMN c INT", "ALTER TABLE t ADD COLUMN c INT"],
#   ["ALTER TABLE t ADD c INT NOT NULL DEFAULT 0", "ALTER TABLE t ADD COLUMN c INT NOT NULL DEFAULT 0"],
#   ["ALTER TABLE t DROP COLUMN c", "ALTER TABLE t DROP COLUMN c"],
#   ["ALTER TABLE t DROP CONSTRAINT c", "ALTER TABLE t DROP CONSTRAINT c"],
#   ["ALTER TABLE t RENAME TO u", "ALTER TABLE t RENAME TO u"],
#   ["ALTER TABLE t RENAME COLUMN a TO b", "ALTER TABLE t RENAME COLUMN a TO b"],
#   ["ALTER TABLE t ADD CONSTRAINT pk PRIMARY KEY (id)", "ALTER TABLE t ADD CONSTRAINT pk PRIMARY KEY (id)"],
#   ["ALTER TABLE ONLY t ADD CONSTRAINT fk FOREIGN KEY (a) REFERENCES u (id) ON DELETE CASCADE", "ALTER TABLE ONLY t ADD CONSTRAINT fk FOREIGN KEY (a) REFERENCES u (id) ON DELETE CASCADE"],
#   ["ALTER TABLE t ADD UNIQUE (a)", "ALTER TABLE t ADD UNIQUE (a)"],
#   ["ALTER TABLE t ADD COLUMN a INT, DROP COLUMN b", "ALTER TABLE t ADD COLUMN a INT, DROP COLUMN b"],
#   ["ALTER TABLE t ALTER COLUMN a SET NOT NULL", "ALTER TABLE t ALTER COLUMN a SET NOT NULL"],
#   ["DROP TABLE t", "DROP TABLE t"],
#   ["DROP TABLE IF EXISTS a, b CASCADE", "DROP TABLE IF EXISTS a, b CASCADE"],
#   ["DROP VIEW v", "DROP VIEW v"],
#   ["DROP INDEX i ON t", "DROP INDEX i ON t"],
#   ["DROP SCHEMA s CASCADE", "DROP SCHEMA s CASCADE"],
#   ["TRUNCATE t", "TRUNCATE TABLE t"],
#   ["TRUNCATE TABLE a, b", "TRUNCATE TABLE a, b"],
#   ["COMMENT ON TABLE t IS 'x'", "COMMENT ON TABLE t IS 'x'"],
#   ["COMMENT ON COLUMN t.c IS 'it''s'", "COMMENT ON COLUMN t.c IS 'it''s'"],
#   ["COMMENT ON COLUMN t.c IS NULL", "COMMENT ON COLUMN t.c IS NULL"],
#   ["GRANT SELECT ON t TO bob", "GRANT SELECT ON t TO bob"],
#   ["SET search_path = public", "SET search_path = public"],
#   ["BEGIN", "BEGIN"],
#   ["SELECT /* c */ 1 -- x\n", "SELECT 1"],
#   ["-- only comment\nSELECT 1", "SELECT 1"],
#   ["SELECT $$a'b$$", "SELECT 'a''b'"],
#   ["SELECT a  FROM\n\tt", "SELECT a FROM t"],
#   ["select a from t where b = 1 order by a desc limit 1", "SELECT a FROM t WHERE b = 1 ORDER BY a DESC LIMIT 1"],
#   ["SELECT \"my col\", \"select\" FROM \"my tbl\"", "SELECT \"my col\", \"select\" FROM \"my tbl\""],
#   ["SELECT * FROM \"s\".\"t\"", "SELECT * FROM \"s\".\"t\""]
# ])
def test_stringify_canonical(sql, expected):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), expected)
end

