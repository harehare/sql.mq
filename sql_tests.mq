#   ["COMMENT ON COLUMN t.c IS NULL"],
#   ["GRANT SELECT ON t TO bob"],
#   ["SET search_path = public"],
#   ["BEGIN"],
#   ["SELECT 1"],
#   ["SELECT 1"],
#   ["SELECT 'a''b'"],
#   ["SELECT a FROM t"],
#   ["SELECT a FROM t WHERE b = 1 ORDER BY a DESC LIMIT 1"],
#   ["SELECT \"my col\", \"select\" FROM \"my tbl\""],
#   ["SELECT * FROM \"s\".\"t\""]
# ])
def test_stringify_is_idempotent(sql):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), sql)
end

# Statement node types
# @parametrize([
#   ["SELECT 1", "select"],
#   ["SELECT 1 UNION SELECT 2", "set_op"],
#   ["VALUES (1)", "values"],
#   ["(SELECT 1)", "select"],
#   ["INSERT INTO t VALUES (1)", "insert"],
#   ["UPDATE t SET a = 1", "update"],
#   ["DELETE FROM t", "delete"],
#   ["CREATE TABLE a (x INT)", "create_table"],
#   ["CREATE TABLE a AS SELECT 1", "create_table"],
#   ["CREATE INDEX i ON t (a)", "create_index"],
#   ["CREATE VIEW v AS SELECT 1", "create_view"],
#   ["ALTER TABLE t DROP COLUMN c", "alter_table"],
#   ["DROP TABLE t", "drop"],
#   ["TRUNCATE t", "truncate"],
#   ["COMMENT ON TABLE t IS 'x'", "comment_on"],
#   ["GRANT ALL ON t TO u", "unknown"],
#   ["BEGIN", "unknown"],
#   ["CREATE FUNCTION f() RETURNS int AS $$ SELECT 1; $$ LANGUAGE sql", "unknown"],
#   ["CREATE TABLE a LIKE b", "unknown"],
#   ["ALTER INDEX i RENAME TO j", "unknown"],
#   ["DROP FUNCTION f", "unknown"],
#   ["COMMENT 'x'", "unknown"],
#   ["WITH c AS (SELECT 1) SELECT * FROM c", "select"],
#   ["WITH c AS (SELECT 1) SELECT 1 UNION SELECT 2", "set_op"]
# ])
def test_statement_type(sql, expected):
  assert_eq(first(sql::sql_ast(sql))["type"], expected)
end

def _expr_of(sql):
  first(first(sql::sql_ast("SELECT " + sql))["columns"])["expr"]
end

# Expression structure: [expression, path into the node, expected value]
# @parametrize([
#   ["a OR b AND c", ["op"], "OR"],
#   ["a OR b AND c", ["right", "op"], "AND"],
#   ["a AND b OR c", ["op"], "OR"],
#   ["1 + 2 * 3", ["op"], "+"],
#   ["1 + 2 * 3", ["right", "op"], "*"],
