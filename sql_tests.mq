#   ["INSERT INTO t SET a"],
#   ["UPDATE t SET (a, b) 1"],
#   ["UPDATE t SET (a, b) ="],
#   ["UPDATE t SET a = 1 ORDER BY"],
#   ["UPDATE t SET a = 1 LIMIT"],
#   ["DELETE FROM t ORDER"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT ON CONSTRAINT"],
#   ["SELECT * FROM a CROSS APPLY"],
#   ["SELECT * FROM a STRAIGHT_JOIN"],
#   ["SELECT * FROM t WITH (NOLOCK"],
#   ["SELECT * FROM t TABLESAMPLE SYSTEM"],
#   ["SELECT * FROM t TABLESAMPLE SYSTEM ("],
#   ["SELECT TOP 5"],
#   ["SELECT TOP 5 FROM t"],
#   ["SELECT a FROM t GROUP BY a WITH"],
#   ["SELECT a FROM t LOCK IN SHARE"],
#   ["CREATE INDEX i ON t (a) INCLUDE (b"],
#   ["SELECT x'FF"],
#   ["SELECT N'abc"],
#   ["SELECT 1 +"],
#   ["SELECT a[]"]
# ])
def test_syntax_error_dialects(sql):
  assert_eq(try: sql::sql_ast(sql) catch: "error", "error")
end

# ===========================================================================
# Quoted identifiers are preserved
# ===========================================================================

# Quoted names print back exactly as written
# @parametrize([
#   ["SELECT \"Users\".\"Id\" FROM \"Users\" WHERE \"Id\" = 1"],
#   ["SELECT `a`, `B` FROM `db`.`T`"],
#   ["SELECT [a], [B] FROM [dbo].[T]"],
#   ["SELECT A, Tbl.B FROM Tbl AS T"],
#   ["SELECT \"a b\", \"select\", \"from\" FROM \"my tbl\""],
#   ["SELECT \"a\"\"b\" FROM t"],
#   ["SELECT `a``b` FROM t"],
#   ["SELECT [a]]b] FROM t"],
#   ["SELECT a AS \"Total\", b AS `X`, c AS [Y] FROM t"],
#   ["SELECT \"T\".* FROM \"T\""],
#   ["SELECT * FROM \"T\" AS \"X\" INNER JOIN \"U\" AS \"V\" USING (\"Id\", b)"],
#   ["SELECT * FROM (SELECT 1) AS \"S\" (\"A\", b)"],
#   ["SELECT * FROM f(1) AS \"G\" (\"A\")"],
#   ["WITH \"C\" (\"X\") AS (SELECT 1) SELECT \"X\" FROM \"C\""],
#   ["SELECT a COLLATE \"C\" FROM t"],
#   ["SELECT \"A\" + b, \"T\".\"C\" || 'x' FROM t"],
#   ["INSERT INTO \"T\" (\"A\", b) VALUES (1, 2)"],
#   ["INSERT INTO `T` SET `A` = 1"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT (\"A\", b) DO UPDATE SET \"B\" = 2"],
#   ["UPDATE \"T\" AS \"X\" SET \"A\" = 1, (\"B\", c) = (1, 2)"],
#   ["UPDATE \"S\".\"T\" SET \"S\".\"T\".\"A\" = 1"],
#   ["DELETE FROM \"T\" AS \"X\" USING \"U\""],
#   ["CREATE INDEX \"I\" ON \"T\" (\"A\") INCLUDE (\"B\", c)"],
#   ["CREATE VIEW \"V\" (\"A\", b) AS SELECT 1"],
#   ["ALTER TABLE \"T\" ADD COLUMN \"C\" INT, DROP COLUMN \"D\", DROP CONSTRAINT \"E\", RENAME COLUMN \"F\" TO \"G\""],
#   ["ALTER TABLE \"T\" RENAME TO \"U\""],
#   ["DROP TABLE \"A\", \"B\".\"C\", d"],
#   ["DROP INDEX \"I\" ON \"T\""],
#   ["TRUNCATE TABLE \"A\", b"],
#   ["COMMENT ON COLUMN \"T\".\"C\" IS 'x'"],
#   ["COMMENT ON TABLE `T` IS NULL"]
# ])
def test_quoted_names_round_trip(sql):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), sql)
end

# Quoted names in CREATE TABLE
# @parametrize([
#   ["CREATE TABLE \"T\" (\"A\" INT PRIMARY KEY, `b` INT REFERENCES \"O\" (\"X\"), [c] INT)", "CREATE TABLE \"T\" (\n  \"A\" INT PRIMARY KEY,\n  `b` INT REFERENCES \"O\" (\"X\"),\n  [c] INT\n)"],
#   ["CREATE TABLE \"S\".\"T\" (\"A\" INT, UNIQUE (\"A\"), FOREIGN KEY (\"A\") REFERENCES \"O\" (\"X\"))", "CREATE TABLE \"S\".\"T\" (\n  \"A\" INT,\n  UNIQUE (\"A\"),\n  FOREIGN KEY (\"A\") REFERENCES \"O\" (\"X\")\n)"],
#   ["CREATE TABLE T (A INT, b INT)", "CREATE TABLE T (\n  A INT,\n  b INT\n)"]
# ])
def test_quoted_names_create_table(sql, expected):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), expected)
end

def _expr_of3(sql):
  first(first(sql::sql_ast("SELECT " + sql))["columns"])["expr"]
end

# Quote style per name part: false for a bare word, otherwise the quote character
# @parametrize([
#   ["\"A\"", ["parts_quoted"], ["\""]],
#   ["a", ["parts_quoted"], [false]],
#   ["`a`.b", ["parts_quoted"], ["`", false]],
#   ["[a].[b].c", ["parts_quoted"], ["[", "[", false]],
#   ["\"t\".*", ["table_quoted"], ["\""]],
#   ["t.*", ["table_quoted"], [false]],
#   ["a COLLATE \"C\"", ["collation_quoted"], ["\""]],
#   ["a COLLATE c", ["collation_quoted"], [false]]
# ])
def test_quoted_flags_in_expressions(sql, path, expected):
  assert_eq(_path(_expr_of3(sql), path), expected)
end

# Quote style on statement nodes
# @parametrize([
#   ["SELECT a AS \"B\"", ["columns", 0, "alias_quoted"], "\""],
#   ["SELECT a AS b", ["columns", 0, "alias_quoted"], false],
#   ["SELECT a `b`", ["columns", 0, "alias_quoted"], "`"],
#   ["SELECT * FROM \"T\"", ["from", 0, "name_quoted"], ["\""]],
#   ["SELECT * FROM s.\"T\"", ["from", 0, "name_quoted"], [false, "\""]],
#   ["SELECT * FROM t AS [x]", ["from", 0, "alias_quoted"], "["],
#   ["SELECT * FROM a JOIN b USING (\"X\", y)", ["from", 0, "using_quoted"], ["\"", false]],
#   ["SELECT * FROM (SELECT 1) s (\"A\", b)", ["from", 0, "columns_quoted"], ["\"", false]],
#   ["SELECT * FROM (SELECT 1) AS \"S\"", ["from", 0, "alias_quoted"], "\""],
#   ["WITH \"C\" (\"X\") AS (SELECT 1) SELECT 1", ["with", 0, "name_quoted"], "\""],
#   ["WITH \"C\" (\"X\", y) AS (SELECT 1) SELECT 1", ["with", 0, "columns_quoted"], ["\"", false]],
#   ["INSERT INTO \"T\" (\"A\", b) VALUES (1, 2)", ["table_quoted"], ["\""]],
#   ["INSERT INTO \"T\" (\"A\", b) VALUES (1, 2)", ["columns_quoted"], ["\"", false]],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT (\"A\") DO NOTHING", ["on_conflict", "target_quoted"], ["\""]],
#   ["UPDATE \"T\" AS \"X\" SET \"A\" = 1", ["table_quoted"], ["\""]],
#   ["UPDATE \"T\" AS \"X\" SET \"A\" = 1", ["alias_quoted"], "\""],
#   ["UPDATE t SET \"A\" = 1", ["set", 0, "column_quoted"], ["\""]],
#   ["UPDATE t SET (\"A\", b) = (1, 2)", ["set", 0, "columns_quoted"], ["\"", false]],
#   ["DELETE FROM \"T\" AS `x`", ["alias_quoted"], "`"],
#   ["CREATE TABLE \"T\" (a INT)", ["name_quoted"], ["\""]],
#   ["CREATE TABLE s.\"T\" (a INT)", ["name_quoted"], [false, "\""]],
#   ["CREATE TABLE t (\"A\" INT, b INT)", ["columns", 0, "name_quoted"], "\""],
#   ["CREATE TABLE t (\"A\" INT, b INT)", ["columns", 1, "name_quoted"], false],
#   ["CREATE TABLE t (a INT REFERENCES \"O\" (\"X\"))", ["columns", 0, "references", "table_quoted"], ["\""]],
#   ["CREATE TABLE t (a INT REFERENCES \"O\" (\"X\"))", ["columns", 0, "references", "columns_quoted"], ["\""]],
#   ["CREATE TABLE t (a INT, PRIMARY KEY (\"A\"))", ["constraints", 0, "columns_quoted"], ["\""]],
#   ["CREATE TABLE t (a INT, FOREIGN KEY (a) REFERENCES \"O\" (\"X\"))", ["constraints", 0, "ref_table_quoted"], ["\""]],
#   ["CREATE TABLE t (a INT, FOREIGN KEY (a) REFERENCES \"O\" (\"X\"))", ["constraints", 0, "ref_columns_quoted"], ["\""]],
#   ["CREATE INDEX \"I\" ON \"T\" (\"A\") INCLUDE (\"B\")", ["name_quoted"], ["\""]],
#   ["CREATE INDEX \"I\" ON \"T\" (\"A\") INCLUDE (\"B\")", ["table_quoted"], ["\""]],
#   ["CREATE INDEX \"I\" ON \"T\" (\"A\") INCLUDE (\"B\")", ["include_quoted"], ["\""]],
#   ["CREATE VIEW \"V\" (\"A\") AS SELECT 1", ["name_quoted"], ["\""]],
#   ["CREATE VIEW \"V\" (\"A\") AS SELECT 1", ["columns_quoted"], ["\""]],
#   ["ALTER TABLE \"T\" DROP COLUMN \"C\"", ["name_quoted"], ["\""]],
#   ["ALTER TABLE \"T\" DROP COLUMN \"C\"", ["actions", 0, "name_quoted"], "\""],
#   ["ALTER TABLE t DROP COLUMN c", ["actions", 0, "name_quoted"], false],
#   ["ALTER TABLE t RENAME COLUMN \"A\" TO `B`", ["actions", 0, "from_quoted"], "\""],
#   ["ALTER TABLE t RENAME COLUMN \"A\" TO `B`", ["actions", 0, "to_quoted"], "`"],
#   ["ALTER TABLE t RENAME TO \"U\"", ["actions", 0, "to_quoted"], "\""],
#   ["DROP TABLE \"A\", b", ["names_quoted"], [["\""], [false]]],
#   ["DROP INDEX i ON \"T\"", ["on_table_quoted"], ["\""]],
#   ["TRUNCATE TABLE \"A\", s.b", ["tables_quoted"], [["\""], [false, false]]],
#   ["COMMENT ON COLUMN \"T\".\"C\" IS 'x'", ["name_quoted"], ["\"", "\""]]
# ])
def test_quoted_flags_in_statements(sql, path, expected):
  assert_eq(_path(first(sql::sql_ast(sql)), path), expected)
end

# ===========================================================================
# Details that used to be dropped are kept
# ===========================================================================

# Printed exactly as written
# @parametrize([
#   ["SELECT ALL a FROM t"],
#   ["SELECT DISTINCT a FROM t"],
#   ["SELECT a FROM t"],
#   ["SELECT * FROM a JOIN b ON TRUE"],
#   ["SELECT * FROM a INNER JOIN b ON TRUE"],
#   ["SELECT * FROM a LEFT JOIN b ON TRUE"],
#   ["SELECT * FROM a LEFT OUTER JOIN b ON TRUE"],
#   ["SELECT * FROM a RIGHT JOIN b ON TRUE"],
#   ["SELECT * FROM a RIGHT OUTER JOIN b ON TRUE"],
#   ["SELECT * FROM a FULL JOIN b ON TRUE"],
#   ["SELECT * FROM a FULL OUTER JOIN b ON TRUE"],
#   ["SELECT * FROM a NATURAL JOIN b"],
#   ["SELECT * FROM a NATURAL LEFT OUTER JOIN b"],
#   ["SELECT * FROM a CROSS JOIN b"],
#   ["SELECT a FROM t LIMIT ALL"],
#   ["SELECT a FROM t LIMIT 5 OFFSET 3 ROWS"],
#   ["SELECT a FROM t OFFSET 1 ROW"],
#   ["SELECT a FROM t OFFSET 1"],
#   ["SELECT a FROM t FETCH FIRST 5 ROWS ONLY"],
#   ["SELECT a FROM t FETCH NEXT 5 ROWS ONLY"],
#   ["SELECT a FROM t FETCH FIRST ROW ONLY"],
#   ["SELECT a FROM t FETCH NEXT 1 ROWS WITH TIES"],
#   ["WITH c AS MATERIALIZED (SELECT 1) SELECT * FROM c"],
#   ["WITH c AS NOT MATERIALIZED (SELECT 1) SELECT * FROM c"],
#   ["WITH c AS (SELECT 1) SELECT * FROM c"],
#   ["SELECT * FROM ONLY t"],
#   ["SELECT * FROM ONLY t AS x, ONLY u"],
#   ["UPDATE ONLY t SET a = 1"],
#   ["UPDATE t SET a = 1"],
#   ["DELETE FROM ONLY t"],
#   ["DELETE FROM t"],
#   ["ALTER TABLE ONLY t DROP COLUMN c"],
#   ["ALTER TABLE t DROP COLUMN c"],
#   ["TRUNCATE TABLE ONLY t"],
#   ["TRUNCATE TABLE t"],
#   ["CREATE INDEX i ON ONLY t (a)"],
#   ["CREATE INDEX i ON t (a)"]
# ])
def test_details_round_trip(sql):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), sql)
end

# CREATE TABLE details
# @parametrize([
#   ["CREATE TABLE a (b INT GENERATED ALWAYS AS (id + 1) STORED)", "CREATE TABLE a (\n  b INT GENERATED ALWAYS AS (id + 1) STORED\n)"],
#   ["CREATE TABLE a (c INT AS (id * 2) VIRTUAL)", "CREATE TABLE a (\n  c INT AS (id * 2) VIRTUAL\n)"],
#   ["CREATE TABLE a (c INT AS (id * 2))", "CREATE TABLE a (\n  c INT AS (id * 2)\n)"],
#   ["CREATE TABLE a (c INT GENERATED BY DEFAULT AS (1) STORED)", "CREATE TABLE a (\n  c INT GENERATED BY DEFAULT AS (1) STORED\n)"],
#   ["CREATE TABLE a (i INT GENERATED ALWAYS AS IDENTITY)", "CREATE TABLE a (\n  i INT GENERATED ALWAYS AS IDENTITY\n)"],
#   ["CREATE TABLE a (i INT GENERATED BY DEFAULT AS IDENTITY)", "CREATE TABLE a (\n  i INT GENERATED BY DEFAULT AS IDENTITY\n)"],
#   ["CREATE TABLE a (i INT GENERATED ALWAYS AS IDENTITY (START WITH 1))", "CREATE TABLE a (\n  i INT GENERATED ALWAYS AS IDENTITY\n)"],
#   ["CREATE TABLE a (i INT AUTO_INCREMENT)", "CREATE TABLE a (\n  i INT AUTO_INCREMENT\n)"],
#   ["CREATE TABLE a (i INTEGER AUTOINCREMENT)", "CREATE TABLE a (\n  i INTEGER AUTOINCREMENT\n)"],
#   ["CREATE TABLE a (u TIMESTAMP DEFAULT now() ON UPDATE now())", "CREATE TABLE a (\n  u TIMESTAMP DEFAULT now() ON UPDATE now()\n)"],
#   ["CREATE TABLE a (u TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP)", "CREATE TABLE a (\n  u TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP\n)"],
#   ["CREATE TABLE a (id INT) ENGINE=InnoDB", "CREATE TABLE a (\n  id INT\n) ENGINE=InnoDB"],
#   ["CREATE TABLE a (id INT) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 ROW_FORMAT=DYNAMIC", "CREATE TABLE a (\n  id INT\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 ROW_FORMAT=DYNAMIC"],
#   ["CREATE TABLE a (id INT) ENGINE=InnoDB COMMENT='x'", "CREATE TABLE a (\n  id INT\n) ENGINE=InnoDB COMMENT = 'x'"],
#   ["CREATE TABLE a (id INT) WITH (fillfactor=70)", "CREATE TABLE a (\n  id INT\n) WITH (fillfactor = 70)"],
#   ["CREATE TABLE a (id INT) PARTITION BY RANGE (id)", "CREATE TABLE a (\n  id INT\n) PARTITION BY RANGE(id)"],
#   ["CREATE TABLE a (id INT) ENGINE=InnoDB PARTITION BY HASH (id) PARTITIONS 4", "CREATE TABLE a (\n  id INT\n) ENGINE=InnoDB PARTITION BY HASH(id) PARTITIONS 4"],
#   ["CREATE TABLE a (id INT) TABLESPACE ts", "CREATE TABLE a (\n  id INT\n) TABLESPACE TS"]
# ])
def test_details_create_table(sql, expected):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), expected)
end

# New fields: [statement, path, expected]
# @parametrize([
#   ["CREATE TABLE a (b INT GENERATED ALWAYS AS (id + 1) STORED)", ["columns", 0, "generated", "storage"], "STORED"],
