#   ["DELETE FROM t WHERE id = 1", "DELETE FROM t WHERE id = 1"],
#   ["DELETE FROM t AS x USING u WHERE x.id = u.id", "DELETE FROM t AS x USING u WHERE x.id = u.id"],
#   ["DELETE FROM ONLY t WHERE a IN (1, 2) RETURNING *", "DELETE FROM ONLY t WHERE a IN (1, 2) RETURNING *"],
#   ["CREATE TABLE a (id INT)", "CREATE TABLE a (\n  id INT\n)"],
#   ["CREATE TEMPORARY TABLE IF NOT EXISTS a (id INT)", "CREATE TEMPORARY TABLE IF NOT EXISTS a (\n  id INT\n)"],
#   ["CREATE TABLE a (id INT PRIMARY KEY, n TEXT NOT NULL)", "CREATE TABLE a (\n  id INT PRIMARY KEY,\n  n TEXT NOT NULL\n)"],
#   ["CREATE TABLE a (id INT NOT NULL DEFAULT 0, n TEXT DEFAULT 'x', t TIMESTAMP DEFAULT now())", "CREATE TABLE a (\n  id INT NOT NULL DEFAULT 0,\n  n TEXT DEFAULT 'x',\n  t TIMESTAMP DEFAULT now()\n)"],
