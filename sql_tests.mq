include "test"
| import "sql"
|

def _t(sql, name):
  first(filter(sql::sql_parse(sql), ->(t): t["name"] == name;))
end

def _c(tbl, name):
  first(filter(tbl["columns"], ->(c): c["name"] == name;))
end

# -- Columns --

def test_parse_basic_columns():
  let t = _t("CREATE TABLE a (id INT, name TEXT);", "a")
  | assert_eq(map(t["columns"], ->(c): c["name"];), ["id", "name"])
  | assert_eq(_c(t, "id")["type"], "INT")
end

def test_parse_type_with_precision():
  let t = _t("CREATE TABLE a (price DECIMAL(10, 2) NOT NULL);", "a")
  | assert_eq(_c(t, "price")["type"], "DECIMAL(10, 2)")
  | assert_eq(_c(t, "price")["nullable"], false)
end

def test_parse_multiword_type():
  let t = _t("CREATE TABLE a (at TIMESTAMP WITH TIME ZONE DEFAULT now(), c CHARACTER VARYING(5));", "a")
  | assert_eq(_c(t, "at")["type"], "TIMESTAMP WITH TIME ZONE")
  | assert_eq(_c(t, "c")["type"], "CHARACTER VARYING(5)")
end

def test_parse_defaults():
  let t = _t("CREATE TABLE a (x TEXT DEFAULT 'a, b', y INT DEFAULT -1, z TEXT DEFAULT 'q'::text, w INT NOT NULL);", "a")
  | assert_eq(_c(t, "x")["default"], "'a, b'")
  | assert_eq(_c(t, "y")["default"], "-1")
  | assert_eq(_c(t, "z")["default"], "'q'::text")
  | assert_eq(_c(t, "w")["default"], None)
end

def test_parse_inline_primary_key_and_unique():
  let t = _t("CREATE TABLE a (id INT PRIMARY KEY, email TEXT UNIQUE);", "a")
  | assert_eq(_c(t, "id")["primary_key"], true)
  | assert_eq(_c(t, "id")["nullable"], false)
  | assert_eq(_c(t, "email")["unique"], true)
  | assert_eq(t["primary_key"], ["id"])
end

def test_parse_auto_increment_and_comment():
  let t = _t("CREATE TABLE a (id INT AUTO_INCREMENT COMMENT 'the id');", "a")
  | assert_eq(_c(t, "id")["auto_increment"], true)
  | assert_eq(_c(t, "id")["comment"], "the id")
end

def test_quoted_identifiers():
  let t = _t("CREATE TABLE `my tbl` (\"a b\" INT, [c] INT);", "my tbl")
  | assert_eq(map(t["columns"], ->(c): c["name"];), ["a b", "c"])
end

# -- Table constraints --

def test_table_level_primary_key():
  let t = _t("CREATE TABLE a (x INT, y INT, CONSTRAINT pk PRIMARY KEY (x, y));", "a")
  | assert_eq(t["primary_key"], ["x", "y"])
  | assert_eq(_c(t, "x")["nullable"], false)
end

def test_table_level_unique():
  let t = _t("CREATE TABLE a (x INT, y INT, UNIQUE (x), UNIQUE (x, y));", "a")
  | assert_eq(_c(t, "x")["unique"], true)
  | assert_eq(_c(t, "y")["unique"], false)
  | assert_eq(t["unique"], [["x"], ["x", "y"]])
end

def test_inline_references():
  let t = _t("CREATE TABLE a (uid INT REFERENCES users (id) ON DELETE CASCADE);", "a")
  | assert_eq(_c(t, "uid")["references"], "users.id")
  | assert_eq(t["foreign_keys"], [{"columns": ["uid"], "ref_table": "users", "ref_columns": ["id"]}])
end

def test_table_level_foreign_key():
  let t = _t("CREATE TABLE a (uid INT, FOREIGN KEY (uid) REFERENCES s.users (id));", "a")
  | assert_eq(_c(t, "uid")["references"], "s.users.id")
end

def test_mysql_key_is_ignored_but_key_column_is_kept():
  let t = _t("CREATE TABLE a (id INT, KEY idx (id), `key` VARCHAR(10));", "a")
  | assert_eq(map(t["columns"], ->(c): c["name"];), ["id", "key"])
end

# -- Statements --

def test_multiple_tables_and_comments_in_sql():
  let r = sql::sql_parse("-- c\nCREATE TABLE a (x INT); /* b */ CREATE TABLE b (y INT);")
  | assert_eq(map(r, ->(t): t["name"];), ["a", "b"])
end

def test_non_ddl_statements_are_ignored():
  let r = sql::sql_parse("INSERT INTO a VALUES (1); CREATE INDEX i ON a (x); DROP TABLE b;")
  | assert_eq(r, [])
end

def test_create_if_not_exists_and_schema():
  let r = sql::sql_parse("CREATE TEMPORARY TABLE IF NOT EXISTS public.a (x INT);")
  | assert_eq(first(r)["name"], "public.a")
end

def test_alter_table_add_constraints():
  let t = _t("CREATE TABLE a (id INT, uid INT); ALTER TABLE ONLY a ADD CONSTRAINT a_pkey PRIMARY KEY (id); ALTER TABLE ONLY a ADD CONSTRAINT fk FOREIGN KEY (uid) REFERENCES u (id);", "a")
  | assert_eq(t["primary_key"], ["id"])
  | assert_eq(_c(t, "uid")["references"], "u.id")
end

def test_comment_on_statements():
  let t = _t("CREATE TABLE a (x INT); COMMENT ON TABLE a IS 'tbl'; COMMENT ON COLUMN a.x IS 'col';", "a")
  | assert_eq(t["comment"], "tbl")
  | assert_eq(_c(t, "x")["comment"], "col")
end

def test_mysql_table_comment():
  let t = _t("CREATE TABLE a (x INT) ENGINE=InnoDB COMMENT='hello';", "a")
  | assert_eq(t["comment"], "hello")
end

def test_unbalanced_parentheses_is_an_error():
  assert_eq(try: sql::sql_parse("CREATE TABLE a (x INT") catch: "error", "error")
end

# -- Markdown --

def test_markdown_output():
  let md = sql::sql_to_markdown("CREATE TABLE a (id INT PRIMARY KEY, n TEXT DEFAULT 'x|y' COMMENT 'p|q'); COMMENT ON TABLE a IS 'Tbl';")
  | assert_eq(md, "## a\n\nTbl\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `id` | `INT` | NO |  | PK |  |\n| `n` | `TEXT` | YES | `'x\\|y'` |  | p\\|q |")
end

def test_markdown_empty_input():
  assert_eq(sql::sql_to_markdown("SELECT 1;"), "")
end

# -- AST: expressions --

def _expr(sql):
  first(first(sql::sql_ast("SELECT " + sql))["columns"])["expr"]
end

def _p(sql):
  sql::sql_stringify(sql::sql_ast(sql))
end

def test_ast_precedence_and_over_or():
  let e = _expr("a OR b AND c")
  | assert_eq(e["op"], "OR")
  | assert_eq(e["right"]["op"], "AND")
end

def test_ast_arithmetic_precedence():
  let e = _expr("1 + 2 * 3")
  | assert_eq(e["op"], "+")
  | assert_eq(e["right"]["op"], "*")
end

def test_ast_literals():
  assert_eq(_expr("'it''s'"), {"type": "literal", "kind": "string", "value": "it's"})
  | assert_eq(_expr("1.5e3")["value"], "1.5e3")
  | assert_eq(_expr("NULL")["kind"], "null")
  | assert_eq(_expr("TRUE")["value"], true)
end

def test_ast_qualified_ident_and_star():
  assert_eq(_expr("s.t.c")["parts"], ["s", "t", "c"])
  | assert_eq(_expr("t.*")["table"], "t")
  | assert_eq(_expr("t.*")["type"], "star")
end

def test_ast_function_call_variants():
  let c = _expr("count(DISTINCT x)")
  | assert_eq(c["name"], "count")
  | assert_eq(c["distinct"], true)
  | assert_eq(_expr("count(*)")["args"], [{"type": "star", "table": None}])
end

def test_ast_window_function():
  let c = _expr("row_number() OVER (PARTITION BY a ORDER BY b DESC)")
  | assert_eq(len(c["over"]["partition_by"]), 1)
  | assert_eq(first(c["over"]["order_by"])["direction"], "DESC")
end

def test_ast_case_cast_between_in():
  assert_eq(len(_expr("CASE WHEN a THEN 1 WHEN b THEN 2 ELSE 3 END")["whens"]), 2)
  | assert_eq(_expr("x::int")["data_type"], "int")
  | assert_eq(_expr("CAST(x AS DECIMAL(10, 2))")["data_type"], "DECIMAL(10, 2)")
  | assert_eq(_expr("a NOT BETWEEN 1 AND 2")["negated"], true)
  | assert_eq(len(_expr("a IN (1, 2, 3)")["values"]), 3)
  | assert_eq(_expr("a IS NOT NULL")["what"], "NULL")
end

def test_ast_params():
  assert_eq(_expr("$1")["value"], "$1")
  | assert_eq(_expr(":name")["value"], ":name")
  | assert_eq(_expr("?")["value"], "?")
end

# -- AST: queries --

def _sel(sql):
  first(sql::sql_ast(sql))
end

def test_ast_select_clauses():
  let q = _sel("SELECT DISTINCT a AS x, b FROM t WHERE a > 1 GROUP BY a, b HAVING count(*) > 1 ORDER BY a DESC LIMIT 5 OFFSET 2")
  | assert_eq(q["type"], "select")
  | assert_eq(q["distinct"], true)
  | assert_eq(first(q["columns"])["alias"], "x")
  | assert_eq(len(q["group_by"]), 2)
  | assert_eq(q["limit"]["value"], "5")
  | assert_eq(q["offset"]["value"], "2")
end

def test_ast_joins():
  let q = _sel("SELECT * FROM a LEFT JOIN b ON a.id = b.id JOIN c USING (id)")
  | let j = first(q["from"])
  | assert_eq(j["type"], "join")
  | assert_eq(j["kind"], "INNER")
  | assert_eq(j["using"], ["id"])
  | assert_eq(j["left"]["kind"], "LEFT")
end

def test_ast_subquery_and_alias():
  let q = _sel("SELECT * FROM (SELECT 1) s, t AS u")
  | assert_eq(first(q["from"])["alias"], "s")
  | assert_eq(q["from"][1]["alias"], "u")
end

def test_ast_cte_and_set_ops():
  let q = _sel("WITH c AS (SELECT 1) SELECT * FROM c UNION ALL SELECT 2 ORDER BY 1")
  | assert_eq(q["type"], "set_op")
  | assert_eq(q["all"], true)
  | assert_eq(first(q["with"])["name"], "c")
  | assert_eq(len(q["order_by"]), 1)
end

def test_ast_mysql_limit_offset():
  let q = _sel("SELECT * FROM t LIMIT 5, 10")
  | assert_eq(q["offset"]["value"], "5")
  | assert_eq(q["limit"]["value"], "10")
end

# -- AST: DML --

def test_ast_insert_values():
  let q = _sel("INSERT INTO t (a, b) VALUES (1, 'x'), (2, 'y') RETURNING a")
  | assert_eq(q["table"], "t")
  | assert_eq(q["columns"], ["a", "b"])
  | assert_eq(len(q["source"]["rows"]), 2)
  | assert_eq(len(q["returning"]), 1)
end

def test_ast_insert_on_conflict():
  let q = _sel("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO UPDATE SET a = 2")
  | assert_eq(q["on_conflict"]["target"], ["a"])
  | assert_eq(first(q["on_conflict"]["set"])["column"], "a")
end

def test_ast_update_and_delete():
  let u = _sel("UPDATE t SET a = 1, b = 2 WHERE id = 3")
  | assert_eq(map(u["set"], ->(x): x["column"];), ["a", "b"])
  | assert_eq(u["where"]["op"], "=")
  | let d = _sel("DELETE FROM t WHERE id = 3")
  | assert_eq(d["table"], "t")
end

# -- AST: DDL --

def test_ast_create_table_node():
  let t = _sel("CREATE TABLE a (id INT PRIMARY KEY, n TEXT DEFAULT 'x' NOT NULL, CHECK (id > 0))")
  | assert_eq(t["type"], "create_table")
  | assert_eq(first(t["columns"])["primary_key"], true)
  | assert_eq(t["columns"][1]["default"]["value"], "x")
  | assert_eq(first(t["constraints"])["kind"], "check")
end

def test_ast_create_index_view_drop():
  assert_eq(_sel("CREATE UNIQUE INDEX i ON t (a, b DESC)")["unique"], true)
  | assert_eq(_sel("CREATE VIEW v AS SELECT 1")["query"]["type"], "select")
  | assert_eq(_sel("DROP TABLE IF EXISTS a, b")["names"], ["a", "b"])
end

def test_ast_alter_table_actions():
  let a = _sel("ALTER TABLE t ADD COLUMN c INT, DROP COLUMN d")
  | assert_eq(map(a["actions"], ->(x): x["action"];), ["add_column", "drop_column"])
end

def test_ast_unknown_statement():
  let u = _sel("GRANT SELECT ON t TO bob")
  | assert_eq(u["type"], "unknown")
  | assert_eq(u["sql"], "GRANT SELECT ON t TO bob")
end

# -- AST: errors and helpers --

def test_ast_syntax_error():
  assert_eq(try: sql::sql_ast("SELECT FROM t") catch: "error", "error")
  | assert_eq(try: sql::sql_ast("SELECT a FROM t WHERE") catch: "error", "error")
end

def test_ast_trailing_tokens_error():
  assert_eq(try: sql::sql_ast("SELECT 1 2 3") catch: "error", "error")
end

def test_sql_find_collects_nested_nodes():
  let ast = sql::sql_ast("SELECT a FROM t JOIN u ON t.id = u.id WHERE x IN (SELECT y FROM v)")
  | assert_eq(map(sql::sql_find(ast, "table"), ->(t): t["name"];), ["t", "u", "v"])
end

# -- Printer --

def test_stringify_round_trips():
  let qs = [
    "SELECT a, b AS c FROM t WHERE a = 1 AND (b > 2 OR c IS NULL) ORDER BY a DESC LIMIT 10",
    "SELECT * FROM a LEFT JOIN b ON a.id = b.id, c WHERE x IN (SELECT y FROM z)",
    "WITH r AS (SELECT 1) SELECT * FROM r UNION ALL SELECT 2",
    "INSERT INTO t (a) VALUES (1), (2) ON CONFLICT (a) DO NOTHING",
    "UPDATE t SET a = a + 1 WHERE id = 1",
    "DELETE FROM t WHERE id = 1",
    "SELECT CASE WHEN a THEN 1 ELSE 2 END, CAST(x AS int), y::text, count(DISTINCT z) FROM t",
    "CREATE UNIQUE INDEX i ON t (a, b DESC)",
    "DROP TABLE IF EXISTS a CASCADE"
  ]
  | assert_eq(map(qs, ->(q): sql::sql_stringify(sql::sql_ast(q)[0]);), qs)
end

def test_stringify_adds_required_parentheses():
  assert_eq(_p("SELECT (a + b) * c, a - (b - c), (a OR b) AND c"), "SELECT (a + b) * c, a - (b - c), (a OR b) AND c;")
  | assert_eq(_p("SELECT a + b * c, (a * b) + c"), "SELECT a + b * c, (a * b) + c;")
end

def test_stringify_quotes_identifiers_when_needed():
  assert_eq(_p("SELECT \"my col\", \"select\" FROM \"my tbl\""), "SELECT \"my col\", \"select\" FROM \"my tbl\";")
end

def test_stringify_statement_array():
  assert_eq(sql::sql_stringify(sql::sql_ast("SELECT 1; SELECT 2")), "SELECT 1;\nSELECT 2;")
end

def test_stringify_ast_edited_by_hand():
  let q = first(sql::sql_ast("SELECT a FROM t"))
  | let edited = set(q, "where", {"type": "binary", "op": "=", "left": {"type": "ident", "parts": ["id"]}, "right": {"type": "literal", "kind": "number", "value": "1"}})
  | assert_eq(sql::sql_stringify(edited), "SELECT a FROM t WHERE id = 1")
end

# ===========================================================================
# Parameterized tests
# ===========================================================================

def _path(node, path):
  fold(path, node, ->(acc, k): acc[k];)
end

def _names(items, field):
  map(items, ->(n): n[field];)
end

# Printer: each input prints as its canonical form
# @parametrize([
#   ["SELECT 1", "SELECT 1"],
#   ["select 1 as one", "SELECT 1 AS one"],
#   ["SELECT 1.5, .5, 1e3, 0xFF, 'a', NULL, TRUE, false", "SELECT 1.5, .5, 1e3, 0xFF, 'a', NULL, TRUE, FALSE"],
#   ["SELECT 'it''s'", "SELECT 'it''s'"],
#   ["SELECT \"Col\", `col2`, [col3] FROM \"T\"", "SELECT \"Col\", `col2`, [col3] FROM \"T\""],
#   ["SELECT a.b.c FROM s.t", "SELECT a.b.c FROM s.t"],
#   ["SELECT t.* FROM t", "SELECT t.* FROM t"],
#   ["SELECT * FROM t AS x", "SELECT * FROM t AS x"],
#   ["SELECT * FROM t x", "SELECT * FROM t AS x"],
#   ["SELECT DISTINCT a FROM t", "SELECT DISTINCT a FROM t"],
#   ["SELECT ALL a FROM t", "SELECT ALL a FROM t"],
#   ["SELECT DISTINCT ON (a, b) a FROM t", "SELECT DISTINCT ON (a, b) a FROM t"],
#   ["SELECT a AS \"x y\" FROM t", "SELECT a AS \"x y\" FROM t"],
#   ["SELECT a + b * c - d / e % f", "SELECT a + b * c - d / e % f"],
#   ["SELECT (a + b) * c", "SELECT (a + b) * c"],
#   ["SELECT a - (b - c)", "SELECT a - (b - c)"],
#   ["SELECT a - b - c", "SELECT a - b - c"],
#   ["SELECT -a, +a, -(a + b)", "SELECT -a, +a, -(a + b)"],
#   ["SELECT 2 ^ 3 ^ 4", "SELECT 2 ^ 3 ^ 4"],
#   ["SELECT a || b || c", "SELECT a || b || c"],
#   ["SELECT a -> 'k' ->> 'j'", "SELECT a -> 'k' ->> 'j'"],
#   ["SELECT a = 1 AND b <> 2 OR c != 3", "SELECT a = 1 AND b <> 2 OR c != 3"],
#   ["SELECT a < 1, a <= 1, a > 1, a >= 1", "SELECT a < 1, a <= 1, a > 1, a >= 1"],
#   ["SELECT a OR b AND c", "SELECT a OR b AND c"],
#   ["SELECT (a OR b) AND c", "SELECT (a OR b) AND c"],
#   ["SELECT NOT a AND b", "SELECT NOT a AND b"],
#   ["SELECT NOT (a AND b)", "SELECT NOT (a AND b)"],
#   ["SELECT NOT a = b", "SELECT NOT a = b"],
#   ["SELECT a IS NULL, a IS NOT NULL, a IS TRUE, a IS NOT FALSE, a IS UNKNOWN", "SELECT a IS NULL, a IS NOT NULL, a IS TRUE, a IS NOT FALSE, a IS UNKNOWN"],
#   ["SELECT a IS DISTINCT FROM b, a IS NOT DISTINCT FROM b", "SELECT a IS DISTINCT FROM b, a IS NOT DISTINCT FROM b"],
#   ["SELECT a BETWEEN 1 AND 2 AND c", "SELECT a BETWEEN 1 AND 2 AND c"],
#   ["SELECT a NOT BETWEEN 1 + 1 AND 2 * 2", "SELECT a NOT BETWEEN 1 + 1 AND 2 * 2"],
#   ["SELECT a IN (1, 2, 3), a NOT IN (1)", "SELECT a IN (1, 2, 3), a NOT IN (1)"],
#   ["SELECT a IN (SELECT b FROM t)", "SELECT a IN (SELECT b FROM t)"],
#   ["SELECT a LIKE 'x%', a NOT LIKE 'x%', a ILIKE 'x', a NOT ILIKE 'y', a SIMILAR TO 'z'", "SELECT a LIKE 'x%', a NOT LIKE 'x%', a ILIKE 'x', a NOT ILIKE 'y', a SIMILAR TO 'z'"],
#   ["SELECT a LIKE 'x!%' ESCAPE '!'", "SELECT a LIKE 'x!%' ESCAPE '!'"],
#   ["SELECT CASE WHEN a THEN 1 END", "SELECT CASE WHEN a THEN 1 END"],
#   ["SELECT CASE a WHEN 1 THEN 'x' WHEN 2 THEN 'y' ELSE 'z' END", "SELECT CASE a WHEN 1 THEN 'x' WHEN 2 THEN 'y' ELSE 'z' END"],
#   ["SELECT CAST(a AS int), CAST(a AS DECIMAL(10, 2)), CAST(a AS timestamp with time zone)", "SELECT CAST(a AS int), CAST(a AS DECIMAL(10, 2)), CAST(a AS timestamp with time zone)"],
#   ["SELECT a::int, a::varchar(10), a::int[], a::double precision, 'x'::text::int", "SELECT a::int, a::varchar(10), a::int[], a::double precision, 'x'::text::int"],
#   ["SELECT -a::int", "SELECT -a::int"],
#   ["SELECT (-a)::int", "SELECT (-a)::int"],
#   ["SELECT EXISTS (SELECT 1), NOT EXISTS (SELECT 1 FROM t)", "SELECT EXISTS (SELECT 1), NOT EXISTS (SELECT 1 FROM t)"],
#   ["SELECT (SELECT max(a) FROM t) AS m", "SELECT (SELECT max(a) FROM t) AS m"],
#   ["SELECT (1, 2), (a, b) = (1, 2)", "SELECT (1, 2), (a, b) = (1, 2)"],
#   ["SELECT DATE '2020-01-01', TIMESTAMP '2020-01-01 00:00:00', TIME '10:00', INTERVAL '1' DAY", "SELECT DATE '2020-01-01', TIMESTAMP '2020-01-01 00:00:00', TIME '10:00', INTERVAL '1' DAY"],
#   ["SELECT now(), count(*), count(DISTINCT a), coalesce(a, b, 0)", "SELECT now(), count(*), count(DISTINCT a), coalesce(a, b, 0)"],
#   ["SELECT s.f(1)", "SELECT s.f(1)"],
#   ["SELECT extract(year FROM d), substring(a FROM 1 FOR 2), position('a' IN b), trim(BOTH 'x' FROM y)", "SELECT extract(year FROM d), substring(a FROM 1 FOR 2), position('a' IN b), trim(BOTH 'x' FROM y)"],
#   ["SELECT left(a, 2), right(a, 2)", "SELECT left(a, 2), right(a, 2)"],
#   ["SELECT $1, $2, ?, :name, @var", "SELECT $1, $2, ?, :name, @var"],
#   ["SELECT sum(a) FILTER (WHERE b > 1)", "SELECT sum(a) FILTER (WHERE b > 1)"],
#   ["SELECT row_number() OVER (), rank() OVER (ORDER BY a DESC NULLS FIRST)", "SELECT row_number() OVER (), rank() OVER (ORDER BY a DESC NULLS FIRST)"],
#   ["SELECT sum(a) OVER (PARTITION BY b, c ORDER BY d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)", "SELECT sum(a) OVER (PARTITION BY b, c ORDER BY d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)"],
#   ["SELECT sum(a) OVER w FROM t WINDOW w AS (PARTITION BY b)", "SELECT sum(a) OVER w FROM t WINDOW w AS (PARTITION BY b)"],
#   ["SELECT a FROM t WINDOW w AS (ORDER BY a), v AS (w ROWS UNBOUNDED PRECEDING)", "SELECT a FROM t WINDOW w AS (ORDER BY a), v AS (w ROWS UNBOUNDED PRECEDING)"],
#   ["SELECT * FROM a JOIN b ON a.id = b.id", "SELECT * FROM a JOIN b ON a.id = b.id"],
#   ["SELECT * FROM a INNER JOIN b USING (id)", "SELECT * FROM a INNER JOIN b USING (id)"],
#   ["SELECT * FROM a LEFT JOIN b ON a.id = b.id", "SELECT * FROM a LEFT JOIN b ON a.id = b.id"],
#   ["SELECT * FROM a LEFT OUTER JOIN b ON a.id = b.id", "SELECT * FROM a LEFT OUTER JOIN b ON a.id = b.id"],
#   ["SELECT * FROM a RIGHT JOIN b ON a.id = b.id", "SELECT * FROM a RIGHT JOIN b ON a.id = b.id"],
#   ["SELECT * FROM a FULL OUTER JOIN b ON a.id = b.id", "SELECT * FROM a FULL OUTER JOIN b ON a.id = b.id"],
#   ["SELECT * FROM a CROSS JOIN b", "SELECT * FROM a CROSS JOIN b"],
#   ["SELECT * FROM a NATURAL JOIN b", "SELECT * FROM a NATURAL JOIN b"],
#   ["SELECT * FROM a, b, c", "SELECT * FROM a, b, c"],
#   ["SELECT * FROM a JOIN b ON a.x = b.x JOIN c ON b.y = c.y", "SELECT * FROM a JOIN b ON a.x = b.x JOIN c ON b.y = c.y"],
#   ["SELECT * FROM a JOIN (b JOIN c ON b.y = c.y) ON a.x = b.x", "SELECT * FROM a JOIN (b JOIN c ON b.y = c.y) ON a.x = b.x"],
#   ["SELECT * FROM (SELECT 1) AS s", "SELECT * FROM (SELECT 1) AS s"],
#   ["SELECT * FROM (SELECT 1) s (x)", "SELECT * FROM (SELECT 1) AS s (x)"],
#   ["SELECT * FROM generate_series(1, 3) AS g", "SELECT * FROM generate_series(1, 3) AS g"],
#   ["SELECT * FROM a, LATERAL (SELECT * FROM b WHERE b.x = a.x) l", "SELECT * FROM a, LATERAL (SELECT * FROM b WHERE b.x = a.x) AS l"],
#   ["SELECT a FROM t WHERE a = 1", "SELECT a FROM t WHERE a = 1"],
#   ["SELECT a FROM t GROUP BY a HAVING count(*) > 1", "SELECT a FROM t GROUP BY a HAVING count(*) > 1"],
#   ["SELECT a FROM t GROUP BY ROLLUP (a, b)", "SELECT a FROM t GROUP BY ROLLUP(a, b)"],
#   ["SELECT a FROM t GROUP BY GROUPING SETS ((a), (b, c))", "SELECT a FROM t GROUP BY GROUPING SETS((a), (b, c))"],
#   ["SELECT a FROM t ORDER BY a", "SELECT a FROM t ORDER BY a"],
#   ["SELECT a FROM t ORDER BY a ASC, b DESC, c DESC NULLS LAST, d NULLS FIRST", "SELECT a FROM t ORDER BY a ASC, b DESC, c DESC NULLS LAST, d NULLS FIRST"],
#   ["SELECT a FROM t LIMIT 10", "SELECT a FROM t LIMIT 10"],
#   ["SELECT a FROM t LIMIT 10 OFFSET 5", "SELECT a FROM t LIMIT 10 OFFSET 5"],
#   ["SELECT a FROM t OFFSET 5 LIMIT 10", "SELECT a FROM t LIMIT 10 OFFSET 5"],
#   ["SELECT a FROM t LIMIT 5, 10", "SELECT a FROM t LIMIT 10 OFFSET 5"],
#   ["SELECT a FROM t LIMIT ALL", "SELECT a FROM t LIMIT ALL"],
#   ["SELECT a FROM t OFFSET 5 ROWS", "SELECT a FROM t OFFSET 5 ROWS"],
#   ["SELECT a FROM t FETCH FIRST 10 ROWS ONLY", "SELECT a FROM t FETCH FIRST 10 ROWS ONLY"],
#   ["SELECT a FROM t FETCH NEXT 3 ROWS WITH TIES", "SELECT a FROM t FETCH NEXT 3 ROWS WITH TIES"],
#   ["SELECT a FROM t FOR UPDATE", "SELECT a FROM t FOR UPDATE"],
#   ["SELECT a FROM t FOR SHARE", "SELECT a FROM t FOR SHARE"],
#   ["SELECT a FROM t FOR NO KEY UPDATE", "SELECT a FROM t FOR NO KEY UPDATE"],
#   ["SELECT a FROM t FOR KEY SHARE", "SELECT a FROM t FOR KEY SHARE"],
#   ["SELECT a FROM t FOR UPDATE NOWAIT", "SELECT a FROM t FOR UPDATE NOWAIT"],
#   ["SELECT a FROM t FOR UPDATE SKIP LOCKED", "SELECT a FROM t FOR UPDATE SKIP LOCKED"],
#   ["SELECT a FROM t FOR UPDATE OF t", "SELECT a FROM t FOR UPDATE OF t"],
#   ["SELECT a FROM t, u FOR UPDATE OF t, u SKIP LOCKED", "SELECT a FROM t, u FOR UPDATE OF t, u SKIP LOCKED"],
#   ["SELECT a FROM t FOR SHARE OF t FOR UPDATE OF u", "SELECT a FROM t FOR SHARE OF t FOR UPDATE OF u"],
#   ["SELECT a FROM t ORDER BY a LIMIT 1 FOR UPDATE", "SELECT a FROM t ORDER BY a LIMIT 1 FOR UPDATE"],
#   ["WITH c AS (SELECT 1) SELECT * FROM c", "WITH c AS (SELECT 1) SELECT * FROM c"],
#   ["WITH c (x) AS (SELECT 1) SELECT x FROM c", "WITH c (x) AS (SELECT 1) SELECT x FROM c"],
#   ["WITH a AS (SELECT 1), b AS (SELECT 2) SELECT * FROM a, b", "WITH a AS (SELECT 1), b AS (SELECT 2) SELECT * FROM a, b"],
#   ["WITH RECURSIVE r (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT * FROM r", "WITH RECURSIVE r (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT * FROM r"],
#   ["WITH c AS MATERIALIZED (SELECT 1) SELECT * FROM c", "WITH c AS MATERIALIZED (SELECT 1) SELECT * FROM c"],
#   ["SELECT 1 UNION SELECT 2", "SELECT 1 UNION SELECT 2"],
#   ["SELECT 1 UNION ALL SELECT 2", "SELECT 1 UNION ALL SELECT 2"],
#   ["SELECT 1 INTERSECT SELECT 2", "SELECT 1 INTERSECT SELECT 2"],
#   ["SELECT 1 EXCEPT SELECT 2", "SELECT 1 EXCEPT SELECT 2"],
#   ["SELECT 1 UNION SELECT 2 UNION SELECT 3", "SELECT 1 UNION SELECT 2 UNION SELECT 3"],
#   ["SELECT 1 UNION SELECT 2 ORDER BY 1 LIMIT 1", "SELECT 1 UNION SELECT 2 ORDER BY 1 LIMIT 1"],
#   ["(SELECT 1 ORDER BY 1 LIMIT 1) UNION (SELECT 2)", "(SELECT 1 ORDER BY 1 LIMIT 1) UNION (SELECT 2)"],
#   ["VALUES (1, 'a'), (2, 'b')", "VALUES (1, 'a'), (2, 'b')"],
#   ["SELECT * FROM (VALUES (1), (2)) AS v (n)", "SELECT * FROM (VALUES (1), (2)) AS v (n)"],
#   ["INSERT INTO t VALUES (1)", "INSERT INTO t VALUES (1)"],
#   ["INSERT INTO t (a, b) VALUES (1, 'x'), (2, 'y')", "INSERT INTO t (a, b) VALUES (1, 'x'), (2, 'y')"],
#   ["INSERT INTO t (a) SELECT b FROM u", "INSERT INTO t (a) SELECT b FROM u"],
