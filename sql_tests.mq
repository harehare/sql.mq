#   ["DROP TABLE t", ["object"], "TABLE"],
#   ["DROP TABLE t", ["names"], ["t"]],
#   ["DROP TABLE IF EXISTS a, s.b", ["names"], ["a", "s.b"]],
#   ["DROP TABLE IF EXISTS a", ["if_exists"], true],
#   ["DROP TABLE a CASCADE", ["cascade"], true],
#   ["DROP TABLE a RESTRICT", ["cascade"], false],
#   ["DROP VIEW v", ["object"], "VIEW"],
#   ["DROP INDEX i", ["object"], "INDEX"],
#   ["DROP INDEX i ON t", ["on_table"], "t"],
#   ["DROP SCHEMA s", ["object"], "SCHEMA"],
#   ["DROP SEQUENCE s", ["object"], "SEQUENCE"],
#   ["DROP DATABASE d", ["object"], "DATABASE"],
#   ["TRUNCATE t", ["tables"], ["t"]],
#   ["TRUNCATE TABLE a, b", ["tables"], ["a", "b"]],
#   ["TRUNCATE ONLY t", ["tables"], ["t"]],
#   ["COMMENT ON TABLE t IS 'x'", ["object"], "TABLE"],
#   ["COMMENT ON TABLE t IS 'x'", ["text"], "x"],
#   ["COMMENT ON COLUMN s.t.c IS 'y'", ["name"], "s.t.c"],
#   ["COMMENT ON TABLE t IS NULL", ["text"], None],
#   ["COMMENT ON INDEX i IS 'z'", ["object"], "INDEX"],
#   ["GRANT ALL ON t TO u", ["keyword"], "grant"],
#   ["GRANT ALL ON t TO u", ["sql"], "GRANT ALL ON t TO u"],
#   ["SET x = 1", ["keyword"], "set"],
#   ["CREATE FUNCTION f() RETURNS int AS $$ SELECT 1; SELECT 2; $$ LANGUAGE sql", ["keyword"], "create"]
# ])
def test_ddl_shape(sql, path, expected):
  assert_eq(_path(first(sql::sql_ast(sql)), path), expected)
end

# sql_find: [statement, node type, field, expected values of that field]
# @parametrize([
#   ["SELECT a FROM t JOIN u ON t.id = u.id", "table", "name", ["t", "u"]],
#   ["SELECT a FROM t WHERE x IN (SELECT y FROM v)", "table", "name", ["t", "v"]],
#   ["SELECT a FROM t WHERE EXISTS (SELECT 1 FROM u)", "table", "name", ["t", "u"]],
#   ["SELECT (SELECT max(b) FROM u) FROM t", "table", "name", ["u", "t"]],
#   ["WITH c AS (SELECT 1 FROM t) SELECT * FROM c", "table", "name", ["t", "c"]],
#   ["SELECT 1 UNION SELECT 2 FROM t", "table", "name", ["t"]],
#   ["SELECT * FROM a, b, c", "table", "name", ["a", "b", "c"]],
#   ["SELECT * FROM (SELECT * FROM a) s", "table", "name", ["a"]],
#   ["INSERT INTO t (a) SELECT b FROM u", "table", "name", ["u"]],
#   ["UPDATE t SET a = 1 FROM u WHERE t.id = u.id", "table", "name", ["u"]],
#   ["DELETE FROM t USING u", "table", "name", ["u"]],
#   ["SELECT 1", "table", "name", []],
#   ["SELECT count(*), max(a), lower(b) FROM t", "call", "name", ["count", "max", "lower"]],
#   ["SELECT a FROM t WHERE f(g(1)) > 0", "call", "name", ["f", "g"]],
#   ["SELECT $1, ?, :n", "param", "value", ["$1", "?", ":n"]],
#   ["SELECT a.b, c", "ident", "parts", [["a", "b"], ["c"]]],
#   ["SELECT CASE WHEN a THEN b END", "case", "else", [None]],
#   ["SELECT 1; SELECT 2", "select", "distinct", [false, false]],
#   ["SELECT 1 UNION SELECT 2", "select", "distinct", [false, false]],
#   ["SELECT 1 UNION SELECT 2", "set_op", "op", ["UNION"]],
#   ["SELECT a FROM (SELECT b FROM u) s", "subquery", "alias", ["s"]],
#   ["SELECT a FROM t JOIN u ON t.x = u.x JOIN v ON u.y = v.y", "join", "kind", ["INNER", "INNER"]],
#   ["SELECT a FROM t WHERE a IN (1, 2) AND b IN (3)", "in", "negated", [false, false]],
#   ["SELECT x::int, CAST(y AS text)", "cast", "style", ["::", "cast"]],
#   ["CREATE TABLE a (x INT, y TEXT)", "column_def", "name", ["x", "y"]],
#   ["CREATE TABLE a (x INT, PRIMARY KEY (x), UNIQUE (x))", "constraint", "kind", ["primary_key", "unique"]],
#   ["CREATE TABLE a (x INT REFERENCES b (id))", "reference", "table", ["b"]],
#   ["CREATE TABLE a (x INT DEFAULT now())", "call", "name", ["now"]],
#   ["ALTER TABLE t ADD COLUMN c INT, DROP COLUMN d", "alter_action", "action", ["add_column", "drop_column"]],
#   ["ALTER TABLE t ADD COLUMN c INT", "column_def", "name", ["c"]],
#   ["INSERT INTO t VALUES (1, 2), (3, 4)", "literal", "value", ["1", "2", "3", "4"]],
#   ["SELECT 1; INSERT INTO t VALUES (2)", "insert", "table", ["t"]],
#   ["SELECT sum(a) OVER (PARTITION BY b ORDER BY c) FROM t", "window", "name", [None]],
#   ["SELECT a FROM t ORDER BY a, b DESC", "order_item", "direction", [None, "DESC"]],
#   ["UPDATE t SET a = 1, b = 2", "assignment", "column", ["a", "b"]],
#   ["INSERT INTO t VALUES (1) ON CONFLICT (a) DO NOTHING", "on_conflict", "action", ["NOTHING"]],
#   ["SELECT a AS x, b FROM t", "select_item", "alias", ["x", None]],
#   ["SELECT a FROM t FOR UPDATE", "locking", "strength", ["UPDATE"]],
#   ["SELECT a FROM t FETCH FIRST 1 ROWS ONLY", "fetch", "with_ties", [false]],
#   ["SELECT a FROM t WINDOW w AS (ORDER BY a)", "named_window", "name", ["w"]],
#   ["WITH a AS (SELECT 1), b AS (SELECT 2) SELECT 1", "cte", "name", ["a", "b"]]
# ])
def test_sql_find(sql, type, field, expected):
  assert_eq(_names(sql::sql_find(sql::sql_ast(sql), type), field), expected)
end

# Syntax errors raise
# @parametrize([
#   ["SELECT"],
#   ["SELECT FROM t"],
#   ["SELECT a FROM"],
#   ["SELECT a FROM t WHERE"],
#   ["SELECT (1"],
#   ["SELECT 1)"],
#   ["SELECT 'abc"],
#   ["SELECT \"abc"],
#   ["SELECT `abc"],
#   ["SELECT $$abc"],
#   ["SELECT a b c"],
#   ["SELECT 1 2"],
#   ["SELECT CASE WHEN a THEN 1"],
#   ["SELECT CASE END"],
#   ["SELECT CASE WHEN a END"],
#   ["SELECT a BETWEEN 1"],
#   ["SELECT a BETWEEN 1 OR 2"],
#   ["SELECT a IN 1"],
#   ["SELECT a IN ("],
#   ["SELECT a IS 1"],
#   ["SELECT CAST(a int)"],
#   ["SELECT CAST(a AS)"],
#   ["SELECT f(1"],
#   ["SELECT f(1,)"],
#   ["SELECT x::"],
#   ["SELECT sum(a) OVER ("],
#   ["SELECT sum(a) FILTER (a)"],
#   ["SELECT a +"],
#   ["SELECT * FROM a JOIN"],
#   ["SELECT * FROM a JOIN b ON"],
#   ["SELECT * FROM (SELECT 1"],
#   ["SELECT * FROM a LEFT b"],
#   ["SELECT 1 UNION"],
#   ["SELECT 1 UNION ALL"],
#   ["SELECT * FROM t FOR UPDATE OF"],
#   ["SELECT a FROM t WINDOW w"],
#   ["SELECT a FROM t WINDOW w AS"],
#   ["SELECT a FROM t LIMIT"],
#   ["SELECT a FROM t ORDER BY"],
#   ["SELECT a FROM t GROUP BY"],
#   ["SELECT a FROM t FETCH FIRST"],
#   ["WITH c AS SELECT 1 SELECT 1"],
#   ["WITH c AS (SELECT 1)"],
#   ["WITH AS (SELECT 1) SELECT 1"],
#   ["WITH c (a AS (SELECT 1) SELECT 1"],
#   ["INSERT INTO"],
#   ["INSERT INTO t VALUES"],
#   ["INSERT INTO t VALUES ("],
#   ["INSERT t VALUES (1)"],
#   ["INSERT INTO t (a VALUES (1)"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT (a) DO"],
#   ["INSERT INTO t VALUES (1) ON DUPLICATE KEY"],
#   ["INSERT INTO t VALUES (1) RETURNING"],
#   ["UPDATE"],
#   ["UPDATE t"],
#   ["UPDATE t SET"],
#   ["UPDATE t SET a"],
#   ["UPDATE t SET a ="],
#   ["UPDATE t SET a = 1 WHERE"],
#   ["DELETE t"],
#   ["DELETE FROM"],
#   ["DELETE FROM t WHERE"],
#   ["DELETE FROM t USING"],
#   ["CREATE TABLE"],
#   ["CREATE TABLE a (id INT"],
#   ["CREATE TABLE a AS"],
#   ["CREATE INDEX i ON"],
#   ["CREATE INDEX i ON t"],
#   ["CREATE INDEX i ON t ("],
#   ["CREATE VIEW v"],
#   ["CREATE VIEW v AS"],
#   ["CREATE VIEW AS SELECT 1"],
#   ["ALTER TABLE"],
#   ["DROP TABLE"],
#   ["DROP TABLE IF EXISTS"],
#   ["COMMENT ON TABLE t"],
#   ["COMMENT ON TABLE t IS"],
#   ["TRUNCATE"],
#   ["VALUES"],
#   ["VALUES (1"],
#   ["SELECT 1; SELECT FROM"]
# ])
def test_syntax_error(sql):
  assert_eq(try: sql::sql_ast(sql) catch: "error", "error")
end

def _schema_col(sql, table, col):
  first(filter(first(filter(sql::sql_parse(sql), ->(t): t["name"] == table;))["columns"], ->(c): c["name"] == col;))
end

# sql_parse columns: [DDL, table, column, field, expected]
# @parametrize([
#   ["CREATE TABLE a (x INT)", "a", "x", "type", "INT"],
#   ["CREATE TABLE a (x INT)", "a", "x", "nullable", true],
#   ["CREATE TABLE a (x INT NOT NULL)", "a", "x", "nullable", false],
#   ["CREATE TABLE a (x INT PRIMARY KEY)", "a", "x", "nullable", false],
#   ["CREATE TABLE a (x INT PRIMARY KEY)", "a", "x", "primary_key", true],
#   ["CREATE TABLE a (x INT, PRIMARY KEY (x))", "a", "x", "primary_key", true],
#   ["CREATE TABLE a (x INT, PRIMARY KEY (x))", "a", "x", "nullable", false],
#   ["CREATE TABLE a (x INT, y INT, PRIMARY KEY (x))", "a", "y", "primary_key", false],
#   ["CREATE TABLE a (X INT, PRIMARY KEY (x))", "a", "X", "primary_key", true],
#   ["CREATE TABLE a (x INT UNIQUE)", "a", "x", "unique", true],
#   ["CREATE TABLE a (x INT, UNIQUE (x))", "a", "x", "unique", true],
#   ["CREATE TABLE a (x INT, y INT, UNIQUE (x, y))", "a", "x", "unique", false],
#   ["CREATE TABLE a (x INT)", "a", "x", "unique", false],
#   ["CREATE TABLE a (x INT AUTO_INCREMENT)", "a", "x", "auto_increment", true],
#   ["CREATE TABLE a (x INT)", "a", "x", "auto_increment", false],
#   ["CREATE TABLE a (x INT DEFAULT 1)", "a", "x", "default", "1"],
#   ["CREATE TABLE a (x INT DEFAULT -1)", "a", "x", "default", "-1"],
#   ["CREATE TABLE a (x TEXT DEFAULT 'a, b')", "a", "x", "default", "'a, b'"],
#   ["CREATE TABLE a (x TEXT DEFAULT 'q'::text)", "a", "x", "default", "'q'::text"],
#   ["CREATE TABLE a (x TS DEFAULT now())", "a", "x", "default", "now()"],
#   ["CREATE TABLE a (x TS DEFAULT CURRENT_TIMESTAMP)", "a", "x", "default", "CURRENT_TIMESTAMP"],
#   ["CREATE TABLE a (x TEXT DEFAULT NULL)", "a", "x", "default", "NULL"],
#   ["CREATE TABLE a (x INT DEFAULT (1 + 2))", "a", "x", "default", "(1 + 2)"],
#   ["CREATE TABLE a (x DECIMAL DEFAULT 0.00)", "a", "x", "default", "0.00"],
#   ["CREATE TABLE a (x INT)", "a", "x", "default", None],
#   ["CREATE TABLE a (x INT DEFAULT nextval('s'::regclass) NOT NULL)", "a", "x", "default", "nextval('s'::regclass)"],
#   ["CREATE TABLE a (x INT COMMENT 'c')", "a", "x", "comment", "c"],
#   ["CREATE TABLE a (x INT)", "a", "x", "comment", None],
#   ["CREATE TABLE a (x INT); COMMENT ON COLUMN a.x IS 'c'", "a", "x", "comment", "c"],
#   ["CREATE TABLE a (x INT COMMENT 'old'); COMMENT ON COLUMN a.x IS 'new'", "a", "x", "comment", "new"],
#   ["CREATE TABLE s.a (x INT); COMMENT ON COLUMN s.a.x IS 'c'", "s.a", "x", "comment", "c"],
#   ["CREATE TABLE s.a (x INT); COMMENT ON COLUMN a.x IS 'c'", "s.a", "x", "comment", "c"],
#   ["CREATE TABLE a (x INT REFERENCES b (id))", "a", "x", "references", "b.id"],
#   ["CREATE TABLE a (x INT REFERENCES b)", "a", "x", "references", "b"],
#   ["CREATE TABLE a (x INT, FOREIGN KEY (x) REFERENCES s.b (id))", "a", "x", "references", "s.b.id"],
#   ["CREATE TABLE a (x INT, y INT, FOREIGN KEY (x, y) REFERENCES b (p, q))", "a", "y", "references", "b.q"],
#   ["CREATE TABLE a (x INT)", "a", "x", "references", None],
#   ["CREATE TABLE a (id INT); ALTER TABLE a ADD CONSTRAINT pk PRIMARY KEY (id)", "a", "id", "primary_key", true],
#   ["CREATE TABLE a (id INT); ALTER TABLE ONLY public.a ADD CONSTRAINT pk PRIMARY KEY (id)", "a", "id", "primary_key", true],
#   ["CREATE TABLE a (u INT); ALTER TABLE a ADD CONSTRAINT fk FOREIGN KEY (u) REFERENCES users (id)", "a", "u", "references", "users.id"],
#   ["CREATE TABLE a (u INT); ALTER TABLE a ADD UNIQUE (u)", "a", "u", "unique", true],
#   ["CREATE TABLE a (u INT); ALTER TABLE b ADD PRIMARY KEY (u)", "a", "u", "primary_key", false],
#   ["CREATE TABLE a (x TIMESTAMP WITH TIME ZONE)", "a", "x", "type", "TIMESTAMP WITH TIME ZONE"],
#   ["CREATE TABLE a (x DECIMAL(10, 2))", "a", "x", "type", "DECIMAL(10, 2)"]
# ])
def test_schema_column(sql, table, col, field, expected):
  assert_eq(_schema_col(sql, table, col)[field], expected)
end

# sql_parse tables: [DDL, table, field, expected]
# @parametrize([
#   ["CREATE TABLE a (x INT, y INT, PRIMARY KEY (x, y))", "a", "primary_key", ["x", "y"]],
#   ["CREATE TABLE a (x INT PRIMARY KEY, y INT)", "a", "primary_key", ["x"]],
#   ["CREATE TABLE a (x INT)", "a", "primary_key", []],
#   ["CREATE TABLE a (x INT, UNIQUE (x), UNIQUE (x, y))", "a", "unique", [["x"], ["x", "y"]]],
#   ["CREATE TABLE a (x INT)", "a", "unique", []],
#   ["CREATE TABLE a (x INT REFERENCES b (id))", "a", "foreign_keys", [{"columns": ["x"], "ref_table": "b", "ref_columns": ["id"]}]],
#   ["CREATE TABLE a (x INT, FOREIGN KEY (x) REFERENCES b (id))", "a", "foreign_keys", [{"columns": ["x"], "ref_table": "b", "ref_columns": ["id"]}]],
#   ["CREATE TABLE a (x INT)", "a", "foreign_keys", []],
#   ["CREATE TABLE a (x INT) COMMENT='c'", "a", "comment", "c"],
#   ["CREATE TABLE a (x INT); COMMENT ON TABLE a IS 'c'", "a", "comment", "c"],
#   ["CREATE TABLE a (x INT)", "a", "comment", None],
#   ["CREATE TABLE a (x INT COMMENT 'p'); COMMENT ON TABLE a IS 't'", "a", "comment", "t"],
#   ["CREATE TABLE s.a (x INT); COMMENT ON TABLE a IS 't'", "s.a", "comment", "t"],
#   ["CREATE TABLE a (x INT, y TEXT)", "a", "name", "a"],
#   ["CREATE TABLE a (x INT, y TEXT, z INT)", "a", "columns|name", ["x", "y", "z"]]
# ])
def test_schema_table(sql, table, field, expected):
  let t = first(filter(sql::sql_parse(sql), ->(x): x["name"] == table;))
  | if (field == "columns|name"): assert_eq(map(t["columns"], ->(c): c["name"];), expected) else: assert_eq(t[field], expected)
end

# sql_parse skips everything but table definitions
# @parametrize([
#   ["SELECT 1", 0],
#   ["INSERT INTO t VALUES (1)", 0],
#   ["UPDATE t SET a = 1", 0],
#   ["DELETE FROM t", 0],
#   ["DROP TABLE a", 0],
#   ["GRANT ALL ON t TO u", 0],
#   ["BEGIN; COMMIT", 0],
#   ["CREATE INDEX i ON t (a)", 0],
#   ["CREATE VIEW v AS SELECT 1", 0],
#   ["CREATE TABLE a AS SELECT 1", 0],
#   ["CREATE TABLE a LIKE b", 0],
#   ["CREATE FUNCTION f() RETURNS int AS $$ SELECT 1 $$ LANGUAGE sql", 0],
#   ["ALTER TABLE a ADD COLUMN c INT", 0],
#   ["COMMENT ON TABLE a IS 'x'", 0],
#   ["", 0],
#   ["-- nothing", 0],
#   ["CREATE TABLE a (x INT)", 1],
#   ["CREATE TEMP TABLE IF NOT EXISTS a (x INT)", 1],
#   ["CREATE TABLE a (x INT); SELECT 1; CREATE TABLE b (y INT)", 2],
#   ["CREATE TABLE a (x INT);\nCREATE TABLE b (y INT);\nCREATE TABLE c (z INT)", 3],
#   ["CREATE TABLE a (x INT); DROP TABLE a; CREATE TABLE a (y INT)", 2]
# ])
def test_schema_table_count(sql, expected):
  assert_eq(len(sql::sql_parse(sql)), expected)
end

# sql_to_markdown: [DDL, expected Markdown]
# @parametrize([
#   ["", ""],
#   ["SELECT 1", ""],
#   ["CREATE TABLE a (x INT)", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | YES |  |  |  |"],
#   ["CREATE TABLE a ()", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|"],
#   ["CREATE TABLE a (x INT NOT NULL DEFAULT 0) COMMENT='Tbl'", "## a\n\nTbl\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | NO | `0` |  |  |"],
#   ["CREATE TABLE a (x INT PRIMARY KEY, y INT UNIQUE, z INT REFERENCES b (id))", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | NO |  | PK |  |\n| `y` | `INT` | YES |  | UK |  |\n| `z` | `INT` | YES |  | FK: b.id |  |"],
#   ["CREATE TABLE a (x INT PRIMARY KEY, UNIQUE (x))", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | NO |  | PK, UK |  |"],
#   ["CREATE TABLE a (x TEXT DEFAULT 'a|b' COMMENT 'p|q')", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `TEXT` | YES | `'a\\|b'` |  | p\\|q |"],
#   ["CREATE TABLE a (x TEXT COMMENT 'l1\nl2')", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `TEXT` | YES |  |  | l1 l2 |"],
#   ["CREATE TABLE s.a (x INT)", "## s.a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | YES |  |  |  |"],
#   ["CREATE TABLE a (x INT); CREATE TABLE b (y INT)", "## a\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | YES |  |  |  |\n\n## b\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `y` | `INT` | YES |  |  |  |"],
#   ["CREATE TABLE a (x INT); COMMENT ON TABLE a IS 'T'; COMMENT ON COLUMN a.x IS 'C'", "## a\n\nT\n\n| Column | Type | Null | Default | Key | Comment |\n|---|---|---|---|---|---|\n| `x` | `INT` | YES |  |  | C |"]
# ])
def test_markdown_output_cases(sql, expected):
  assert_eq(sql::sql_to_markdown(sql), expected)
end

# ===========================================================================
# Extended dialect coverage
# ===========================================================================

# Printer: dialect constructs print as their canonical form
# @parametrize([
#   ["SELECT a FROM t WHERE x = ANY(ARRAY[1,2,3])", "SELECT a FROM t WHERE x = ANY (ARRAY[1, 2, 3])"],
#   ["SELECT ARRAY[1,2,3]", "SELECT ARRAY[1, 2, 3]"],
#   ["SELECT arr[1] FROM t", "SELECT arr[1] FROM t"],
#   ["SELECT a FROM t WHERE d > now() - INTERVAL '1 day'", "SELECT a FROM t WHERE d > now() - INTERVAL '1 day'"],
#   ["SELECT a FROM t WHERE d > now() - INTERVAL '1' DAY", "SELECT a FROM t WHERE d > now() - INTERVAL '1' DAY"],
#   ["SELECT 'a' 'b'", "SELECT 'ab'"],
#   ["SELECT E'a\\nb'", "SELECT 'a\nb'"],
#   ["SELECT N'abc'", "SELECT N'abc'"],
#   ["SELECT x'FF', B'101'", "SELECT X'FF', B'101'"],
#   ["SELECT a FROM t GROUP BY a WITH ROLLUP", "SELECT a FROM t GROUP BY a WITH ROLLUP"],
#   ["SELECT a FROM t LOCK IN SHARE MODE", "SELECT a FROM t LOCK IN SHARE MODE"],
#   ["SELECT TOP 10 a FROM t", "SELECT TOP 10 a FROM t"],
#   ["SELECT a FROM t WITH (NOLOCK)", "SELECT a FROM t WITH (NOLOCK)"],
#   ["SELECT a FROM t TABLESAMPLE SYSTEM (10)", "SELECT a FROM t TABLESAMPLE SYSTEM (10)"],
#   ["SELECT a FROM t WHERE a = ALL (SELECT b FROM u)", "SELECT a FROM t WHERE a = ALL (SELECT b FROM u)"],
#   ["SELECT a FROM t WHERE a > SOME (SELECT b FROM u)", "SELECT a FROM t WHERE a > SOME (SELECT b FROM u)"],
#   ["SELECT COUNT(*) FILTER (WHERE a) OVER () FROM t", "SELECT COUNT(*) FILTER (WHERE a) OVER () FROM t"],
#   ["SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a) FROM t", "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a) FROM t"],
#   ["SELECT a COLLATE \"C\" FROM t", "SELECT a COLLATE \"C\" FROM t"],
#   ["SELECT a AT TIME ZONE 'UTC' FROM t", "SELECT a AT TIME ZONE 'UTC' FROM t"],
#   ["SELECT a::int FROM t WHERE b ~ 'x' AND c !~* 'y'", "SELECT a::int FROM t WHERE b ~ 'x' AND c !~* 'y'"],
#   ["SELECT a FROM t WHERE (a, b) IN ((1, 2), (3, 4))", "SELECT a FROM t WHERE (a, b) IN ((1, 2), (3, 4))"],
#   ["SELECT a FROM t WHERE a IS NOT DISTINCT FROM b", "SELECT a FROM t WHERE a IS NOT DISTINCT FROM b"],
#   ["SELECT CASE WHEN a THEN b END AS c FROM t", "SELECT CASE WHEN a THEN b END AS c FROM t"],
#   ["SELECT * FROM t1 JOIN t2 ON t1.a = t2.a AND t1.b = t2.b WHERE t1.c IS NULL", "SELECT * FROM t1 JOIN t2 ON t1.a = t2.a AND t1.b = t2.b WHERE t1.c IS NULL"],
#   ["SELECT * FROM a CROSS APPLY b", "SELECT * FROM a CROSS APPLY b"],
#   ["SELECT * FROM a OUTER APPLY (SELECT 1) x", "SELECT * FROM a OUTER APPLY (SELECT 1) AS x"],
#   ["SELECT * FROM a STRAIGHT_JOIN b ON a.x = b.x", "SELECT * FROM a STRAIGHT_JOIN b ON a.x = b.x"],
#   ["SELECT json_agg(a ORDER BY b) FROM t", "SELECT json_agg(a ORDER BY b) FROM t"],
#   ["SELECT string_agg(a, ',' ORDER BY b) FROM t", "SELECT string_agg(a, ',' ORDER BY b) FROM t"],
#   ["SELECT SUM(a) OVER (ORDER BY b RANGE BETWEEN INTERVAL '1' DAY PRECEDING AND CURRENT ROW) FROM t", "SELECT SUM(a) OVER (ORDER BY b RANGE BETWEEN INTERVAL '1' DAY PRECEDING AND CURRENT ROW) FROM t"],
#   ["SELECT a FROM t UNION SELECT b FROM u ORDER BY 1", "SELECT a FROM t UNION SELECT b FROM u ORDER BY 1"],
#   ["WITH c AS (SELECT 1) INSERT INTO t SELECT * FROM c", "WITH c AS (SELECT 1) INSERT INTO t SELECT * FROM c"],
#   ["WITH c AS (SELECT 1) UPDATE t SET a = 1", "WITH c AS (SELECT 1) UPDATE t SET a = 1"],
#   ["WITH c AS (SELECT 1) DELETE FROM t", "WITH c AS (SELECT 1) DELETE FROM t"],
#   ["WITH RECURSIVE c AS (SELECT 1) DELETE FROM t USING c", "WITH RECURSIVE c AS (SELECT 1) DELETE FROM t USING c"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT ON CONSTRAINT pk DO NOTHING", "INSERT INTO t (a) VALUES (1) ON CONFLICT ON CONSTRAINT pk DO NOTHING"],
#   ["INSERT INTO t SET a = 1", "INSERT INTO t SET a = 1"],
#   ["UPDATE t SET (a, b) = (1, 2)", "UPDATE t SET (a, b) = (1, 2)"],
#   ["UPDATE t SET (a, b) = (SELECT 1, 2)", "UPDATE t SET (a, b) = (SELECT 1, 2)"],
#   ["UPDATE t SET a = 1 ORDER BY b LIMIT 1", "UPDATE t SET a = 1 ORDER BY b LIMIT 1"],
#   ["DELETE FROM t ORDER BY b LIMIT 1", "DELETE FROM t ORDER BY b LIMIT 1"],
#   ["CREATE TABLE a (id SERIAL PRIMARY KEY, n TEXT)", "CREATE TABLE a (\n  id SERIAL PRIMARY KEY,\n  n TEXT\n)"],
#   ["CREATE TABLE a (id INT GENERATED ALWAYS AS (b + 1) STORED)", "CREATE TABLE a (\n  id INT GENERATED ALWAYS AS (b + 1) STORED\n)"],
#   ["CREATE TABLE a (id INT, PRIMARY KEY (id)) PARTITION BY RANGE (id)", "CREATE TABLE a (\n  id INT,\n  PRIMARY KEY (id)\n) PARTITION BY RANGE(id)"],
#   ["CREATE TABLE a (id INT, EXCLUDE USING gist (c WITH &&))", "CREATE TABLE a (\n  id INT,\n  EXCLUDE USING gist(c WITH &&)\n)"],
#   ["CREATE TABLE a (LIKE b INCLUDING ALL)", "CREATE TABLE a (\n  LIKE b INCLUDING ALL\n)"],
#   ["CREATE TABLE a (id INT) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", "CREATE TABLE a (\n  id INT\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"],
#   ["CREATE TABLE a (id INT NOT NULL AUTO_INCREMENT, PRIMARY KEY (id)) ENGINE=InnoDB", "CREATE TABLE a (\n  id INT NOT NULL AUTO_INCREMENT,\n  PRIMARY KEY (id)\n) ENGINE=InnoDB"],
#   ["CREATE TABLE a (c INT DEFAULT 1 ON UPDATE CURRENT_TIMESTAMP)", "CREATE TABLE a (\n  c INT DEFAULT 1 ON UPDATE CURRENT_TIMESTAMP\n)"],
#   ["CREATE TYPE mood AS ENUM ('a', 'b')", "CREATE TYPE mood AS ENUM ('a', 'b')"],
#   ["CREATE SEQUENCE s START 1", "CREATE SEQUENCE s START 1"],
#   ["CREATE SCHEMA s", "CREATE SCHEMA s"],
#   ["CREATE EXTENSION IF NOT EXISTS pgcrypto", "CREATE EXTENSION IF NOT EXISTS pgcrypto"],
#   ["CREATE TRIGGER t BEFORE INSERT ON a FOR EACH ROW EXECUTE FUNCTION f()", "CREATE TRIGGER t BEFORE INSERT ON a FOR EACH ROW EXECUTE FUNCTION f()"],
#   ["CREATE FUNCTION f() RETURNS int LANGUAGE sql AS 'SELECT 1'", "CREATE FUNCTION f() RETURNS int LANGUAGE sql AS 'SELECT 1'"],
#   ["CREATE INDEX i ON t (a) INCLUDE (b)", "CREATE INDEX i ON t (a) INCLUDE (b)"],
#   ["CREATE INDEX i ON t (a COLLATE \"C\" DESC)", "CREATE INDEX i ON t (a COLLATE \"C\" DESC)"],
#   ["ALTER TABLE t ALTER COLUMN a TYPE int USING a::int", "ALTER TABLE t ALTER COLUMN a TYPE int USING a::int"],
#   ["ALTER TABLE t ADD COLUMN a INT AFTER b", "ALTER TABLE t ADD COLUMN a INT AFTER b"],
#   ["ALTER TABLE t ENABLE ROW LEVEL SECURITY", "ALTER TABLE t ENABLE ROW LEVEL SECURITY"],
#   ["ALTER TABLE t OWNER TO u", "ALTER TABLE t OWNER TO u"],
#   ["DROP FUNCTION f(int)", "DROP FUNCTION f(int)"],
#   ["EXPLAIN SELECT 1", "EXPLAIN SELECT 1"],
#   ["BEGIN", "BEGIN"],
#   ["COMMIT", "COMMIT"],
#   ["SET search_path TO public", "SET search_path TO public"],
#   ["USE db", "USE db"],
#   ["SHOW TABLES", "SHOW TABLES"],
#   ["GRANT SELECT ON t TO u", "GRANT SELECT ON t TO u"],
#   ["VACUUM", "VACUUM"],
#   ["SELECT 1;;", "SELECT 1"],
#   ["SELECT @@version", "SELECT @@version"],
#   ["SELECT @x := 1", "SELECT @x := 1"],
#   ["SELECT `a` FROM `db`.`t`", "SELECT `a` FROM `db`.`t`"],
#   ["SELECT \"a\" FROM \"s\".\"t\"", "SELECT \"a\" FROM \"s\".\"t\""],
#   ["SELECT [a] FROM [dbo].[t]", "SELECT [a] FROM [dbo].[t]"],
#   ["SELECT 1e10, 1E-5, 0b101", "SELECT 1e10, 1E-5, 0b101"],
#   ["SELECT a FROM t -- trailing", "SELECT a FROM t"],
#   ["SELECT a /* c */ FROM t", "SELECT a FROM t"],
#   ["SELECT a # mysql comment", "SELECT a"],
#   ["SELECT a FROM t WHERE a LIKE 'x' || b", "SELECT a FROM t WHERE a LIKE 'x' || b"],
#   ["SELECT -1, - 1, +1", "SELECT -1, -1, +1"],
#   ["SELECT a FROM t FETCH FIRST ROW ONLY", "SELECT a FROM t FETCH FIRST ROW ONLY"],
#   ["SELECT a FROM t WHERE a = $1::int", "SELECT a FROM t WHERE a = $1::int"],
#   ["SELECT $$a$$", "SELECT 'a'"],
#   ["SELECT $tag$a$tag$", "SELECT 'a'"],
#   ["SELECT a FROM t WHERE a->>'k' = 'v'", "SELECT a FROM t WHERE a ->> 'k' = 'v'"],
#   ["SELECT a FROM t WHERE a @> '{\"k\":1}'::jsonb", "SELECT a FROM t WHERE a @> '{\"k\":1}'::jsonb"],
#   ["SELECT a FROM unnest(ARRAY[1,2]) AS u(x)", "SELECT a FROM unnest(ARRAY[1, 2]) AS u (x)"],
#   ["SELECT * FROM t, LATERAL f(t.a)", "SELECT * FROM t, LATERAL f(t.a)"],
#   ["SELECT a FROM t NATURAL LEFT JOIN u", "SELECT a FROM t NATURAL LEFT JOIN u"],
#   ["SELECT a FROM t WHERE EXISTS (SELECT 1) AND NOT EXISTS (SELECT 2)", "SELECT a FROM t WHERE EXISTS (SELECT 1) AND NOT EXISTS (SELECT 2)"],
#   ["VALUES (1) UNION VALUES (2)", "VALUES (1) UNION VALUES (2)"],
#   ["(SELECT 1)", "(SELECT 1)"],
#   ["((SELECT 1))", "(SELECT 1)"],
#   ["SELECT 1 FROM (SELECT 1) AS x JOIN (SELECT 2) AS y ON TRUE", "SELECT 1 FROM (SELECT 1) AS x JOIN (SELECT 2) AS y ON TRUE"],
#   ["SELECT a COLLATE pg_catalog.\"default\" FROM t", "SELECT a COLLATE pg_catalog.\"default\" FROM t"],
#   ["SELECT a[1][2], (ARRAY[1,2])[1]", "SELECT a[1][2], (ARRAY[1, 2])[1]"],
#   ["SELECT ARRAY(SELECT 1)", "SELECT ARRAY(SELECT 1)"],
#   ["SELECT 'x' AS \"y\", 'a'", "SELECT 'x' AS \"y\", 'a'"],
#   ["SELECT x FROM t WHERE y = ANY (SELECT 1)", "SELECT x FROM t WHERE y = ANY (SELECT 1)"],
#   ["SELECT TOP (5) PERCENT WITH TIES a FROM t ORDER BY a", "SELECT TOP (5) PERCENT WITH TIES a FROM t ORDER BY a"],
#   ["SELECT DISTINCT TOP 3 a FROM t", "SELECT DISTINCT TOP 3 a FROM t"],
#   ["SELECT a FROM t WITH (NOLOCK, INDEX(i))", "SELECT a FROM t WITH (NOLOCK, INDEX(i))"],
#   ["SELECT a FROM t AS x TABLESAMPLE BERNOULLI (5) REPEATABLE (1)", "SELECT a FROM t AS x TABLESAMPLE BERNOULLI (5) REPEATABLE (1)"],
#   ["SELECT a FROM t GROUP BY a, b WITH ROLLUP", "SELECT a FROM t GROUP BY a, b WITH ROLLUP"],
#   ["SELECT * FROM a CROSS APPLY f(a.x) AS g", "SELECT * FROM a CROSS APPLY f(a.x) AS g"],
#   ["UPDATE t SET (a, b) = (1, 2), c = 3 WHERE d", "UPDATE t SET (a, b) = (1, 2), c = 3 WHERE d"],
#   ["DELETE FROM t WHERE a ORDER BY b DESC LIMIT 2", "DELETE FROM t WHERE a ORDER BY b DESC LIMIT 2"],
#   ["INSERT INTO t SET a = 1, b = 2", "INSERT INTO t SET a = 1, b = 2"],
#   ["INSERT INTO t (a) VALUES (1) ON CONFLICT ON CONSTRAINT pk DO UPDATE SET a = 2", "INSERT INTO t (a) VALUES (1) ON CONFLICT ON CONSTRAINT pk DO UPDATE SET a = 2"],
#   ["WITH c AS (SELECT 1) INSERT INTO t (a) SELECT * FROM c RETURNING a", "WITH c AS (SELECT 1) INSERT INTO t (a) SELECT * FROM c RETURNING a"],
#   ["WITH a AS (SELECT 1), b AS (SELECT 2) UPDATE t SET x = 1 FROM a, b", "WITH a AS (SELECT 1), b AS (SELECT 2) UPDATE t SET x = 1 FROM a, b"],
#   ["CREATE TABLE a (x INT, EXCLUDE USING gist (c WITH &&), CHECK (x > 0))", "CREATE TABLE a (\n  x INT,\n  EXCLUDE USING gist(c WITH &&),\n  CHECK (x > 0)\n)"],
#   ["CREATE UNIQUE INDEX i ON t USING btree (a) INCLUDE (b, c) WHERE a > 0", "CREATE UNIQUE INDEX i ON t USING BTREE (a) INCLUDE (b, c) WHERE a > 0"],
#   ["SELECT a FROM unnest(ARRAY[1,2]) AS u(x), generate_series(1, 2) g(n)", "SELECT a FROM unnest(ARRAY[1, 2]) AS u (x), generate_series(1, 2) AS g (n)"]
# ])
def test_stringify_canonical_dialects(sql, expected):
  assert_eq(sql::sql_stringify(first(sql::sql_ast(sql))), expected)
end

