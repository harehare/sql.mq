#   ["a BETWEEN 1 AND 2 AND c", ["op"], "AND"],
#   ["a IN (1, 2)", ["values", 1, "value"], "2"],
#   ["a NOT IN (1)", ["negated"], true],
#   ["a IN (SELECT 1)", ["query", "type"], "select"],
#   ["a IS NOT NULL", ["what"], "NULL"],
#   ["a IS NOT NULL", ["negated"], true],
#   ["a IS TRUE", ["what"], "TRUE"],
#   ["a IS NULL", ["negated"], false],
#   ["a IS DISTINCT FROM b", ["op"], "IS DISTINCT FROM"],
#   ["a IS NOT DISTINCT FROM b", ["op"], "IS NOT DISTINCT FROM"],
#   ["a LIKE 'x' ESCAPE '!'", ["escape", "value"], "!"],
#   ["a NOT LIKE 'x'", ["op"], "NOT LIKE"],
#   ["a ILIKE 'x'", ["op"], "ILIKE"],
#   ["a SIMILAR TO 'x'", ["op"], "SIMILAR TO"],
#   ["'it''s'", ["value"], "it's"],
#   ["'a'", ["kind"], "string"],
#   ["1.5e3", ["value"], "1.5e3"],
#   ["1.5e3", ["kind"], "number"],
#   ["0xFF", ["value"], "0xFF"],
#   [".5", ["value"], ".5"],
#   ["NULL", ["kind"], "null"],
#   ["TRUE", ["value"], true],
#   ["FALSE", ["value"], false],
#   ["DEFAULT", ["kind"], "default"],
#   ["s.t.c", ["parts"], ["s", "t", "c"]],
#   ["\"a b\"", ["parts"], ["a b"]],
#   ["t.*", ["table"], "t"],
#   ["t.*", ["type"], "star"],
#   ["*", ["table"], None],
#   ["count(DISTINCT a)", ["distinct"], true],
#   ["count(*)", ["args", 0, "type"], "star"],
#   ["s.f(1)", ["name"], "s.f"],
#   ["now()", ["args"], []],
#   ["coalesce(a, b, 0)", ["args", 2, "value"], "0"],
#   ["extract(year FROM d)", ["seps"], ["FROM"]],
#   ["substring(a FROM 1 FOR 2)", ["seps"], ["FROM", "FOR"]],
#   ["position('a' IN b)", ["seps"], ["IN"]],
#   ["trim(BOTH 'x' FROM y)", ["modifier"], "BOTH"],
#   ["f(a, b)", ["seps"], [","]],
#   ["sum(a) FILTER (WHERE b > 1)", ["filter", "op"], ">"],
#   ["sum(a) OVER (PARTITION BY b ORDER BY c DESC)", ["over", "order_by", 0, "direction"], "DESC"],
#   ["sum(a) OVER (PARTITION BY b ORDER BY c DESC)", ["over", "partition_by", 0, "parts"], ["b"]],
#   ["rank() OVER w", ["over", "name"], "w"],
#   ["rank() OVER ()", ["over", "partition_by"], []],
#   ["sum(a) OVER (ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)", ["over", "frame"], "ROWS BETWEEN 1 PRECEDING AND CURRENT ROW"],
#   ["rank() OVER (ORDER BY a NULLS LAST)", ["over", "order_by", 0, "nulls"], "LAST"],
#   ["CASE WHEN a THEN 1 END", ["whens", 0, "result", "value"], "1"],
#   ["CASE a WHEN 1 THEN 2 END", ["operand", "parts"], ["a"]],
#   ["CASE WHEN a THEN 1 ELSE 2 END", ["else", "value"], "2"],
#   ["CASE WHEN a THEN 1 END", ["else"], None],
#   ["CAST(x AS DECIMAL(10, 2))", ["data_type"], "DECIMAL(10, 2)"],
#   ["CAST(x AS int)", ["style"], "cast"],
#   ["x::int", ["style"], "::"],
#   ["x::timestamp with time zone", ["data_type"], "timestamp with time zone"],
#   ["x::int[]", ["data_type"], "int[]"],
#   ["x::double precision", ["data_type"], "double precision"],
#   ["x::a.b", ["data_type"], "a.b"],
#   ["x::varchar(10)", ["data_type"], "varchar(10)"],
#   ["'1'::int::text", ["expr", "data_type"], "int"],
#   ["EXISTS (SELECT 1)", ["type"], "exists"],
#   ["(SELECT 1)", ["type"], "subquery"],
#   ["(1, 2)", ["items", 1, "value"], "2"],
#   ["(1)", ["paren"], true],
#   ["INTERVAL '1' DAY", ["unit"], "DAY"],
#   ["INTERVAL '1 day'", ["unit"], None],
#   ["DATE '2020-01-01'", ["data_type"], "DATE"],
#   ["TIMESTAMP '2020-01-01'", ["value"], "2020-01-01"],
#   ["$1", ["value"], "$1"],
#   ["?", ["type"], "param"],
#   [":name", ["value"], ":name"],
#   ["@var", ["parts"], ["@var"]],
#   ["a -> 'k'", ["op"], "->"],
#   ["a ->> 'k'", ["op"], "->>"],
#   ["a @> b", ["op"], "@>"],
#   ["a && b", ["op"], "&&"],
#   ["a ~ 'x'", ["op"], "~"],
#   ["a % b", ["op"], "%"],
#   ["a / b", ["op"], "/"]
# ])
def test_expression_shape(sql, path, expected):
  assert_eq(_path(_expr_of(sql), path), expected)
end

# Statement structure: [statement, path into the first node, expected value]
# @parametrize([
#   ["SELECT a FROM t", ["from", 0, "name"], "t"],
#   ["SELECT a FROM t AS x", ["from", 0, "alias"], "x"],
#   ["SELECT a FROM t x", ["from", 0, "alias"], "x"],
#   ["SELECT a FROM s.t", ["from", 0, "name"], "s.t"],
#   ["SELECT a AS x", ["columns", 0, "alias"], "x"],
#   ["SELECT a x", ["columns", 0, "alias"], "x"],
#   ["SELECT a", ["columns", 0, "alias"], None],
#   ["SELECT DISTINCT a", ["distinct"], true],
#   ["SELECT a", ["distinct"], false],
#   ["SELECT DISTINCT ON (a) b", ["distinct_on", 0, "parts"], ["a"]],
#   ["SELECT a FROM t WHERE a = 1", ["where", "op"], "="],
#   ["SELECT a FROM t GROUP BY a, b", ["group_by", 1, "parts"], ["b"]],
#   ["SELECT a FROM t HAVING count(*) > 1", ["having", "op"], ">"],
#   ["SELECT a FROM t ORDER BY a DESC", ["order_by", 0, "direction"], "DESC"],
#   ["SELECT a FROM t ORDER BY a", ["order_by", 0, "direction"], None],
#   ["SELECT a FROM t LIMIT 5", ["limit", "value"], "5"],
#   ["SELECT a FROM t OFFSET 3", ["offset", "value"], "3"],
#   ["SELECT a FROM t LIMIT 5, 10", ["offset", "value"], "5"],
#   ["SELECT a FROM t LIMIT 5, 10", ["limit", "value"], "10"],
#   ["SELECT a FROM t LIMIT ALL", ["limit", "kind"], "all"],
#   ["SELECT a FROM t FETCH FIRST 10 ROWS ONLY", ["fetch", "count", "value"], "10"],
#   ["SELECT a FROM t FETCH FIRST ROW ONLY", ["fetch", "count"], None],
#   ["SELECT a FROM t FETCH FIRST 1 ROWS WITH TIES", ["fetch", "with_ties"], true],
#   ["SELECT a FROM t FOR UPDATE", ["locking", 0, "strength"], "UPDATE"],
#   ["SELECT a FROM t FOR SHARE", ["locking", 0, "strength"], "SHARE"],
#   ["SELECT a FROM t FOR NO KEY UPDATE", ["locking", 0, "strength"], "NO KEY UPDATE"],
#   ["SELECT a FROM t FOR KEY SHARE", ["locking", 0, "strength"], "KEY SHARE"],
#   ["SELECT a FROM t FOR UPDATE OF t, u", ["locking", 0, "of"], ["t", "u"]],
#   ["SELECT a FROM t FOR UPDATE NOWAIT", ["locking", 0, "wait"], "NOWAIT"],
#   ["SELECT a FROM t FOR UPDATE SKIP LOCKED", ["locking", 0, "wait"], "SKIP LOCKED"],
#   ["SELECT a FROM t FOR UPDATE", ["locking", 0, "wait"], None],
#   ["SELECT a FROM t FOR SHARE FOR UPDATE", ["locking", 1, "strength"], "UPDATE"],
#   ["SELECT a FROM t", ["locking"], []],
#   ["SELECT a FROM t WINDOW w AS (ORDER BY a)", ["windows", 0, "name"], "w"],
#   ["SELECT a FROM t WINDOW w AS (ORDER BY a), v AS (w)", ["windows", 1, "spec", "name"], "w"],
#   ["SELECT a FROM t WINDOW w AS (PARTITION BY a)", ["windows", 0, "spec", "partition_by", 0, "parts"], ["a"]],
#   ["SELECT a FROM t JOIN u ON t.x = u.x", ["from", 0, "kind"], "INNER"],
#   ["SELECT a FROM t LEFT JOIN u ON t.x = u.x", ["from", 0, "kind"], "LEFT"],
#   ["SELECT a FROM t RIGHT OUTER JOIN u ON t.x = u.x", ["from", 0, "kind"], "RIGHT"],
#   ["SELECT a FROM t FULL JOIN u ON t.x = u.x", ["from", 0, "kind"], "FULL"],
#   ["SELECT a FROM t CROSS JOIN u", ["from", 0, "kind"], "CROSS"],
#   ["SELECT a FROM t NATURAL JOIN u", ["from", 0, "natural"], true],
#   ["SELECT a FROM t JOIN u USING (x, y)", ["from", 0, "using"], ["x", "y"]],
#   ["SELECT a FROM t JOIN u ON t.x = u.x", ["from", 0, "on", "op"], "="],
#   ["SELECT a FROM t JOIN u ON 1 = 1 JOIN v ON 2 = 2", ["from", 0, "left", "type"], "join"],
#   ["SELECT a FROM t, u", ["from", 1, "name"], "u"],
#   ["SELECT a FROM (SELECT 1) s", ["from", 0, "alias"], "s"],
#   ["SELECT a FROM (SELECT 1) s", ["from", 0, "query", "type"], "select"],
#   ["SELECT a FROM (SELECT 1) s (x, y)", ["from", 0, "columns"], ["x", "y"]],
#   ["SELECT a FROM f(1) g", ["from", 0, "type"], "table_function"],
#   ["SELECT a FROM t, LATERAL (SELECT 1) l", ["from", 1, "lateral"], true],
#   ["SELECT a FROM t", ["from", 0, "type"], "table"],
#   ["WITH c AS (SELECT 1) SELECT 1", ["with", 0, "name"], "c"],
#   ["WITH c (x, y) AS (SELECT 1, 2) SELECT 1", ["with", 0, "columns"], ["x", "y"]],
#   ["WITH RECURSIVE c AS (SELECT 1) SELECT 1", ["recursive"], true],
#   ["WITH a AS (SELECT 1), b AS (SELECT 2) SELECT 1", ["with", 1, "name"], "b"],
#   ["SELECT 1", ["with"], []],
#   ["SELECT 1 UNION ALL SELECT 2", ["all"], true],
#   ["SELECT 1 UNION SELECT 2", ["all"], false],
#   ["SELECT 1 INTERSECT SELECT 2", ["op"], "INTERSECT"],
#   ["SELECT 1 EXCEPT SELECT 2", ["op"], "EXCEPT"],
#   ["SELECT 1 UNION SELECT 2 UNION SELECT 3", ["left", "op"], "UNION"],
#   ["(SELECT 1 LIMIT 1) UNION (SELECT 2)", ["left", "paren"], true],
#   ["(SELECT 1 LIMIT 1) UNION (SELECT 2)", ["left", "limit", "value"], "1"],
#   ["SELECT 1 UNION SELECT 2 LIMIT 3", ["limit", "value"], "3"],
#   ["VALUES (1, 2), (3, 4)", ["rows", 1, 0, "value"], "3"],
#   ["INSERT INTO t VALUES (1)", ["table"], "t"],
#   ["INSERT INTO t (a, b) VALUES (1, 2)", ["columns"], ["a", "b"]],
#   ["INSERT INTO t (a) VALUES (1), (2)", ["source", "rows", 1, 0, "value"], "2"],
#   ["INSERT INTO t (a) SELECT 1", ["source", "type"], "select"],
#   ["INSERT INTO t DEFAULT VALUES", ["source"], None],
#   ["INSERT INTO t (a) (SELECT 1)", ["source", "paren"], true],
#   ["INSERT OR REPLACE INTO t VALUES (1)", ["modifier"], "OR REPLACE"],
#   ["INSERT IGNORE INTO t VALUES (1)", ["modifier"], "IGNORE"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT DO NOTHING", ["on_conflict", "action"], "NOTHING"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT (a, b) DO NOTHING", ["on_conflict", "target"], ["a", "b"]],
#   ["INSERT INTO t VALUES (1) ON CONFLICT (a) DO UPDATE SET b = 1", ["on_conflict", "set", 0, "column"], "b"],
#   ["INSERT INTO t VALUES (1) ON CONFLICT (a) DO UPDATE SET b = 1 WHERE c", ["on_conflict", "where", "parts"], ["c"]],
#   ["INSERT INTO t VALUES (1) ON DUPLICATE KEY UPDATE a = 1", ["on_duplicate_key_update", 0, "column"], "a"],
#   ["INSERT INTO t VALUES (1) RETURNING a, b", ["returning", 1, "expr", "parts"], ["b"]],
#   ["INSERT INTO t VALUES (1)", ["on_conflict"], None],
#   ["UPDATE t SET a = 1, b = 2", ["set", 1, "column"], "b"],
#   ["UPDATE t SET a = 1", ["set", 0, "value", "value"], "1"],
#   ["UPDATE t x SET a = 1", ["alias"], "x"],
#   ["UPDATE t SET a = 1 WHERE b", ["where", "parts"], ["b"]],
#   ["UPDATE t SET a = 1 FROM u", ["from", 0, "name"], "u"],
#   ["UPDATE t SET a = 1 RETURNING a", ["returning", 0, "expr", "parts"], ["a"]],
#   ["UPDATE s.t SET a = 1", ["table"], "s.t"],
#   ["DELETE FROM t", ["table"], "t"],
#   ["DELETE FROM t x", ["alias"], "x"],
#   ["DELETE FROM t WHERE a", ["where", "parts"], ["a"]],
#   ["DELETE FROM t USING u", ["using", 0, "name"], "u"],
#   ["DELETE FROM t RETURNING *", ["returning", 0, "expr", "type"], "star"]
# ])
def test_statement_shape(sql, path, expected):
  assert_eq(_path(first(sql::sql_ast(sql)), path), expected)
end

